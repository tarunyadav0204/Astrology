# Sentry (crash reporting)
EXPO_PUBLIC_SENTRY_DSN=

# Meta / Facebook App Events (Meta Events Manager → your app → Settings)
# App ID: Settings → Basic. Client token: Settings → Advanced → Client token.
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=
# Set to 1 to print [FB_EVENTS] lines to logcat (ReactNativeJS) in release builds too.
EXPO_PUBLIC_FACEBOOK_DEBUG_LOG=

# AppsFlyer MMP (Dev Key from AppsFlyer dashboard → App Settings).
# Android-only UA can omit the iOS App Store id; iOS init is skipped without it.
EXPO_PUBLIC_APPSFLYER_DEV_KEY=
EXPO_PUBLIC_APPSFLYER_IOS_APP_ID=
# Optional OneLink subdomain, e.g. astroroshni.onelink.me
EXPO_PUBLIC_APPSFLYER_ONELINK_HOST=
# Set to 1 for verbose AppsFlyer logs in release builds too.
EXPO_PUBLIC_APPSFLYER_DEBUG=
