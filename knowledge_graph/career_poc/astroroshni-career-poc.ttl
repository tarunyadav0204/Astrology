# Shared and subtype-specific stage nodes for the parity routes.
career:CareerFoundationStage a ar:DecisionStage ; ar:sequence 1 ; skos:prefLabel "D1 promise and D10 professional expression"@en ; ar:stageRequiresFactor career:D1, career:D10 .
