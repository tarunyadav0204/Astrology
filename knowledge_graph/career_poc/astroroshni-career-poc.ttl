@prefix ar: <https://astroroshni.com/ontology/core#> .
@prefix career: <https://astroroshni.com/ontology/career#> .
@prefix domain: <https://astroroshni.com/ontology/domain#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://astroroshni.com/ontology/career-poc>
    a owl:Ontology ;
    rdfs:label "AstroRoshni Career Ontology proof of concept"@en ;
    owl:versionInfo "0.6.0" ;
    rdfs:comment "Editable authoring model for Career question routing, astrology requirements, calculators, evidence and answer contracts. It does not contain native chart data or predictions."@en .

# ---------------------------------------------------------------------------
# Core schema. These classes are deliberately domain-neutral so later modules
# can reuse them for health, marriage, education and other life areas.
# ---------------------------------------------------------------------------

ar:LifeDomain a owl:Class ; rdfs:label "Life domain"@en .
ar:QuestionType a owl:Class ; rdfs:label "Question type"@en .
ar:AnswerMode a owl:Class ; rdfs:label "Answer mode"@en .
ar:AnswerContract a owl:Class ; rdfs:label "Answer contract"@en .
ar:AstrologyFactor a owl:Class ; rdfs:label "Astrology factor"@en .
ar:HouseFactor a owl:Class ; rdfs:subClassOf ar:AstrologyFactor ; rdfs:label "House factor"@en .
ar:ChartFactor a owl:Class ; rdfs:subClassOf ar:AstrologyFactor ; rdfs:label "Chart factor"@en .
ar:JaiminiFactor a owl:Class ; rdfs:subClassOf ar:AstrologyFactor ; rdfs:label "Jaimini factor"@en .
ar:TimingFactor a owl:Class ; rdfs:subClassOf ar:AstrologyFactor ; rdfs:label "Timing factor"@en .
ar:CalculatorCapability a owl:Class ; rdfs:label "Calculator capability"@en .
ar:DecisionRule a owl:Class ; rdfs:label "Decision rule"@en .
ar:EvidencePolicy a owl:Class ; rdfs:label "Evidence policy"@en .
ar:OutputSection a owl:Class ; rdfs:label "Output section"@en .
ar:Guardrail a owl:Class ; rdfs:label "Guardrail"@en .
ar:DecisionStage a owl:Class ; rdfs:label "Decision stage"@en .

ar:inDomain a owl:ObjectProperty ; rdfs:label "Life domain"@en ; rdfs:domain ar:QuestionType ; rdfs:range ar:LifeDomain .
ar:requiresFactor a owl:ObjectProperty ; rdfs:label "Required astrology factors"@en ; rdfs:domain ar:QuestionType ; rdfs:range ar:AstrologyFactor .
ar:defaultExcludesFactor a owl:ObjectProperty ; rdfs:label "Excluded by default"@en ; rdfs:domain ar:QuestionType ; rdfs:range ar:AstrologyFactor .
ar:requiresCapability a owl:ObjectProperty ; rdfs:label "Required calculator capabilities"@en ; rdfs:domain ar:QuestionType ; rdfs:range ar:CalculatorCapability .
ar:usesAnswerContract a owl:ObjectProperty ; rdfs:label "Answer contract"@en ; rdfs:domain ar:QuestionType ; rdfs:range ar:AnswerContract .
ar:allowedAnswerMode a owl:ObjectProperty ; rdfs:label "Answer mode"@en ; rdfs:domain ar:QuestionType ; rdfs:range ar:AnswerMode .
ar:hasEvidencePolicy a owl:ObjectProperty ; rdfs:label "Evidence policy"@en ; rdfs:domain ar:QuestionType ; rdfs:range ar:EvidencePolicy .
ar:evaluatesRule a owl:ObjectProperty ; rdfs:label "Decision rules"@en ; rdfs:domain ar:QuestionType ; rdfs:range ar:DecisionRule .
ar:hasGuardrail a owl:ObjectProperty ; rdfs:label "Guardrails"@en ; rdfs:domain ar:QuestionType ; rdfs:range ar:Guardrail .
ar:hasOutputSection a owl:ObjectProperty ; rdfs:label "Output sections"@en ; rdfs:domain ar:AnswerContract ; rdfs:range ar:OutputSection .
ar:evaluatesStage a owl:ObjectProperty ; rdfs:label "Decision stages"@en ; rdfs:domain ar:QuestionType ; rdfs:range ar:DecisionStage .
ar:stageRequiresFactor a owl:ObjectProperty ; rdfs:label "Required astrology factors"@en ; rdfs:domain ar:DecisionStage ; rdfs:range ar:AstrologyFactor .
ar:stableId a owl:DatatypeProperty ; rdfs:range xsd:string .
ar:runtimeKey a owl:DatatypeProperty ; rdfs:range xsd:string .
ar:calculatorBinding a owl:DatatypeProperty ; rdfs:range xsd:string .
ar:questionExample a owl:DatatypeProperty ; rdfs:range xsd:string .
ar:ruleText a owl:DatatypeProperty ; rdfs:range xsd:string .
ar:overrideCondition a owl:DatatypeProperty ; rdfs:range xsd:string .
ar:sequence a owl:DatatypeProperty ; rdfs:range xsd:integer .
ar:sourceType a owl:DatatypeProperty ; rdfs:range xsd:string .
ar:confidencePolicy a owl:DatatypeProperty ; rdfs:range xsd:string .
ar:priority a owl:DatatypeProperty ; rdfs:range xsd:integer .

# ---------------------------------------------------------------------------
# Career factors and executable capabilities.
# ---------------------------------------------------------------------------

career:Career a ar:LifeDomain ; ar:stableId "career" ; skos:prefLabel "Career"@en ; owl:sameAs domain:CareerWorkPublicRole .

career:H1 a ar:HouseFactor ; ar:stableId "house.1" ; skos:prefLabel "Professional identity, initiative and leadership capacity"@en .
career:H2 a ar:HouseFactor ; ar:stableId "house.2" ; skos:prefLabel "Income, compensation and resources"@en .
career:H3 a ar:HouseFactor ; ar:stableId "house.3" ; skos:prefLabel "Initiative, movement and change"@en .
career:H5 a ar:HouseFactor ; ar:stableId "house.5" ; skos:prefLabel "Judgment, strategy, creativity and leadership intelligence"@en .
career:H6 a ar:HouseFactor ; ar:stableId "house.6" ; skos:prefLabel "Employment, workload, service and competition"@en .
career:H7 a ar:HouseFactor ; ar:stableId "house.7" ; skos:prefLabel "Business, clients, contracts and partnerships"@en .
career:H8 a ar:HouseFactor ; ar:stableId "house.8" ; skos:prefLabel "Disruption, restructuring, hidden pressure and forced change"@en .
career:H9 a ar:HouseFactor ; ar:stableId "house.9" ; skos:prefLabel "Manager, mentor, authority and guidance"@en .
career:H10 a ar:HouseFactor ; ar:stableId "house.10" ; skos:prefLabel "Role, status, authority and visible responsibility"@en .
career:H11 a ar:HouseFactor ; ar:stableId "house.11" ; skos:prefLabel "Recognition, gains, networks and goals"@en .
career:H12 a ar:HouseFactor ; ar:stableId "house.12" ; skos:prefLabel "Release, separation and exit"@en .

career:D1 a ar:ChartFactor ; ar:stableId "chart.d1" ; skos:prefLabel "D1 natal professional foundation"@en .
career:D10 a ar:ChartFactor ; ar:stableId "chart.d10" ; skos:prefLabel "D10 professional expression"@en .
career:Amatyakaraka a ar:JaiminiFactor ; ar:stableId "jaimini.amatyakaraka" ; skos:prefLabel "Amatyakaraka vocation indicator"@en .
career:Karakamsha a ar:JaiminiFactor ; ar:stableId "jaimini.karakamsha" ; skos:prefLabel "Karakamsha vocation confirmation"@en .
career:DashaActivation a ar:TimingFactor ; ar:stableId "timing.dasha_activation" ; skos:prefLabel "Dasha house activation"@en .
career:TransitActivation a ar:TimingFactor ; ar:stableId "timing.transit_activation" ; skos:prefLabel "Transit confirmation"@en .

career:CapD1Foundation a ar:CalculatorCapability ;
    ar:stableId "career.foundation.d1" ;
    ar:calculatorBinding "instant_chat_v2 evidence builder: D1 house foundation" ;
    skos:prefLabel "Build D1 Career foundation"@en .

career:CapD10Expression a ar:CalculatorCapability ;
    ar:stableId "career.expression.d10" ;
    ar:calculatorBinding "instant_chat_v2 evidence builder: D10 professional expression" ;
    skos:prefLabel "Build D10 professional expression"@en .

career:CapJaiminiVocation a ar:CalculatorCapability ;
    ar:stableId "career.vocation.jaimini" ;
    ar:calculatorBinding "instant_chat_v2.career.build_vocation_synthesis" ;
    skos:prefLabel "Synthesize Amatyakaraka and Karakamsha vocation"@en .

career:CapDashaActivation a ar:CalculatorCapability ;
    ar:stableId "career.timing.dasha" ;
    ar:calculatorBinding "authoritative dasha calculator and house activation" ;
    skos:prefLabel "Calculate dasha activation"@en .

career:CapTransitActivation a ar:CalculatorCapability ;
    ar:stableId "career.timing.transit" ;
    ar:calculatorBinding "transit activation calculator" ;
    skos:prefLabel "Calculate transit confirmation"@en .

career:CapStayChangeDecision a ar:CalculatorCapability ;
    ar:stableId "career.decision.stay_change" ;
    ar:calculatorBinding "instant_chat_v2.career.classify_career_decision" ;
    skos:prefLabel "Compare stay, change, separation and landing"@en .

career:CapRecognitionConversion a ar:CalculatorCapability ;
    ar:stableId "career.diagnosis.recognition" ;
    ar:calculatorBinding "instant_chat_v2.user_derivation recognition conversion" ;
    skos:prefLabel "Diagnose effort-to-recognition conversion"@en .

career:CapManagerRelationship a ar:CalculatorCapability ;
    ar:stableId "career.relationship.manager" ;
    ar:calculatorBinding "career relationship synthesis: manager_relationship" ;
    skos:prefLabel "Synthesize manager relationship"@en .

career:CapPromotionDecision a ar:CalculatorCapability ;
    ar:stableId "career.decision.promotion" ;
    ar:calculatorBinding "career stage synthesis: promotion H10-H11-H2 with dasha and transit" ;
    skos:prefLabel "Evaluate promotion and recognition delivery"@en .

career:CapCompensationDecision a ar:CalculatorCapability ;
    ar:stableId "career.decision.compensation" ;
    ar:calculatorBinding "career stage synthesis: compensation H2-H6-H10-H11 with dasha and transit" ;
    skos:prefLabel "Evaluate salary and compensation delivery"@en .

career:CapBusinessEmploymentDecision a ar:CalculatorCapability ;
    ar:stableId "career.decision.business_employment" ;
    ar:calculatorBinding "career path synthesis: employment H6 versus enterprise H3-H7 with H10-H11 viability" ;
    skos:prefLabel "Compare employment and business suitability"@en .

career:CapJobChangeTiming a ar:CalculatorCapability ;
    ar:stableId "career.timing.job_change" ;
    ar:calculatorBinding "career stage synthesis: H3-H10 movement, H10-H12 release, H2-H6-H10-H11 landing" ;
    skos:prefLabel "Calculate job-change windows and landing quality"@en .

career:CapWorkplaceConflict a ar:CalculatorCapability ;
    ar:stableId "career.diagnosis.workplace_conflict" ;
    ar:calculatorBinding "career relationship synthesis: H6 conflict, H9 manager, H10 authority and H11 support" ;
    skos:prefLabel "Diagnose workplace conflict"@en .

career:CapEmploymentDelivery a ar:CalculatorCapability ; ar:stableId "career.delivery.employment" ;
    ar:calculatorBinding "instant_chat_v2.career.classify_manifestations: employment selection and joining" ; skos:prefLabel "Evaluate employment delivery"@en .
career:CapOfferDelivery a ar:CalculatorCapability ; ar:stableId "career.delivery.offer" ;
    ar:calculatorBinding "instant_chat_v2.career.classify_manifestations: offer formalization" ; skos:prefLabel "Evaluate job-offer delivery"@en .
career:CapJoiningDelivery a ar:CalculatorCapability ; ar:stableId "career.delivery.joining" ;
    ar:calculatorBinding "instant_chat_v2.career.classify_manifestations: role-change and joining execution" ; skos:prefLabel "Evaluate joining delivery"@en .
career:CapJobSecurityDecision a ar:CalculatorCapability ; ar:stableId "career.decision.job_security" ;
    ar:calculatorBinding "instant_chat_v2.career.classify_career_decision: continuity and disruption" ; skos:prefLabel "Evaluate job security"@en .
career:CapBusinessProfile a ar:CalculatorCapability ; ar:stableId "career.profile.business" ;
    ar:calculatorBinding "instant_chat_v2.career business profile synthesis from D1 D10 and H7" ; skos:prefLabel "Synthesize business profile"@en .
career:CapBusinessLaunch a ar:CalculatorCapability ; ar:stableId "career.delivery.business_launch" ;
    ar:calculatorBinding "instant_chat_v2.career.classify_manifestations: business launch" ; skos:prefLabel "Evaluate business launch"@en .
career:CapBusinessSuccess a ar:CalculatorCapability ; ar:stableId "career.delivery.business_success" ;
    ar:calculatorBinding "instant_chat_v2.career.classify_manifestations: business growth" ; skos:prefLabel "Evaluate business success"@en .
career:CapProjectDelivery a ar:CalculatorCapability ; ar:stableId "career.delivery.project" ;
    ar:calculatorBinding "instant_chat_v2.career.classify_manifestations: project execution and outcome" ; skos:prefLabel "Evaluate project delivery"@en .
career:CapLeadershipProfile a ar:CalculatorCapability ; ar:stableId "career.profile.leadership" ;
    ar:calculatorBinding "instant_chat_v2 career foundation synthesis: leadership profile" ; skos:prefLabel "Synthesize leadership potential"@en .
career:CapGovernmentCareer a ar:CalculatorCapability ; ar:stableId "career.delivery.government" ;
    ar:calculatorBinding "instant_chat_v2.career.classify_manifestations: government selection" ; skos:prefLabel "Evaluate government-career delivery"@en .
career:CapForeignCareer a ar:CalculatorCapability ; ar:stableId "career.delivery.foreign" ;
    ar:calculatorBinding "instant_chat_v2.career.classify_manifestations: foreign career" ; skos:prefLabel "Evaluate foreign-career delivery"@en .
career:CapReturnToWork a ar:CalculatorCapability ; ar:stableId "career.delivery.return_to_work" ;
    ar:calculatorBinding "instant_chat_v2.career.classify_manifestations: return to employment" ; skos:prefLabel "Evaluate return to work"@en .
career:CapCareerStagnation a ar:CalculatorCapability ; ar:stableId "career.diagnosis.stagnation" ;
    ar:calculatorBinding "instant_chat_v2.user_derivation career blockage diagnosis" ; skos:prefLabel "Diagnose career stagnation"@en .
career:CapColleagueRelationship a ar:CalculatorCapability ; ar:stableId "career.relationship.colleague" ;
    ar:calculatorBinding "career relationship synthesis: colleague_relationship" ; skos:prefLabel "Synthesize colleague relationship"@en .
career:CapSubordinateRelationship a ar:CalculatorCapability ; ar:stableId "career.relationship.subordinate" ;
    ar:calculatorBinding "career relationship synthesis: subordinate_relationship" ; skos:prefLabel "Synthesize subordinate relationship"@en .
career:CapClientRelationship a ar:CalculatorCapability ; ar:stableId "career.relationship.client" ;
    ar:calculatorBinding "career relationship synthesis: client_relationship" ; skos:prefLabel "Synthesize client relationship"@en .
career:CapBusinessPartnerRelationship a ar:CalculatorCapability ; ar:stableId "career.relationship.business_partner" ;
    ar:calculatorBinding "career relationship synthesis: business_partner_relationship" ; skos:prefLabel "Synthesize business-partner relationship"@en .
career:CapMentorRelationship a ar:CalculatorCapability ; ar:stableId "career.relationship.mentor" ;
    ar:calculatorBinding "career relationship synthesis: mentor_relationship" ; skos:prefLabel "Synthesize mentor relationship"@en .

# ---------------------------------------------------------------------------
# Answer modes, evidence policies, contracts and guardrails.
# ---------------------------------------------------------------------------

career:ModeTopicReading a ar:AnswerMode ; ar:runtimeKey "topic_reading" ; skos:prefLabel "Topic reading"@en .
career:ModePotentialCapacity a ar:AnswerMode ; ar:runtimeKey "potential_capacity" ; skos:prefLabel "Potential capacity"@en .
career:ModeDecisionSupport a ar:AnswerMode ; ar:runtimeKey "decision_support" ; skos:prefLabel "Decision support"@en .
career:ModeProblemDiagnosis a ar:AnswerMode ; ar:runtimeKey "problem_diagnosis" ; skos:prefLabel "Problem diagnosis"@en .
career:ModeRelationshipReading a ar:AnswerMode ; ar:runtimeKey "relationship_reading" ; skos:prefLabel "Work relationship reading"@en .

career:EvidenceStaticCareer a ar:EvidencePolicy ; ar:stableId "evidence.career.static" ;
    ar:ruleText "Explain the D1 foundation, D10 expression, 10th-lord work function, Amatyakaraka and Karakamsha; do not manufacture dates." .
career:EvidenceDecision a ar:EvidencePolicy ; ar:stableId "evidence.career.decision" ;
    ar:ruleText "Show which planets activate each required house through lordship, occupation or aspect, then show dasha support and transit confirmation separately." .
career:EvidenceRecognition a ar:EvidencePolicy ; ar:stableId "evidence.career.recognition" ;
    ar:ruleText "Explain the conversion chain from H6 effort to H10 visibility to H11 recognition and H2 compensation; identify the broken or delayed link." .
career:EvidenceManager a ar:EvidencePolicy ; ar:stableId "evidence.career.manager" ;
    ar:ruleText "Explain H9 manager/guidance, H10 authority/reputation, H6 daily friction and H11 support; do not substitute vocation indicators." .
career:EvidencePromotion a ar:EvidencePolicy ; ar:stableId "evidence.career.promotion" ;
    ar:ruleText "Separate increased responsibility at H10 from recognition at H11 and compensation at H2; name the activating dasha planets and require transit confirmation for a high-confidence dated window." .
career:EvidenceCompensation a ar:EvidencePolicy ; ar:stableId "evidence.career.compensation" ;
    ar:ruleText "Explain whether H2 income, H6 employment, H10 role and H11 gains form a complete delivery chain; do not call workload or visibility alone a salary increase." .
career:EvidenceBusinessEmployment a ar:EvidencePolicy ; ar:stableId "evidence.career.business_employment" ;
    ar:ruleText "Compare H6 employment support with H3 initiative and H7 commerce/client support, anchored by H10 profession and H11 viability; use D10 and Jaimini vocation as confirmation." .
career:EvidenceJobChangeTiming a ar:EvidencePolicy ; ar:stableId "evidence.career.job_change_timing" ;
    ar:ruleText "For every proposed window show H3+H10 movement, H10+H12 release and H2+H6+H10+H11 landing separately, including the planets activating each house and independent transit confirmation." .
career:EvidencePromotionVsJobChange a ar:EvidencePolicy ; ar:stableId "evidence.career.promotion_vs_job_change" ;
    ar:ruleText "Compare promotion delivery (H10 responsibility, H11 recognition, H2 compensation) against job-change movement (H3+H10), release (H10+H12), and landing (H2+H6+H10+H11) in the same horizon. Do not select either option without option-specific dasha and transit support." .
career:EvidenceWorkplaceConflict a ar:EvidencePolicy ; ar:stableId "evidence.career.workplace_conflict" ;
    ar:ruleText "Distinguish H6 daily conflict, H9 manager or mentor dynamics, H10 authority and reputation, and H11 team support; identify which relationship link is under pressure." .
career:EvidenceEmployment a ar:EvidencePolicy ; ar:stableId "evidence.career.employment" ; ar:ruleText "Separate employability and applications at H6, role delivery at H10, selection or gains at H11 and compensation at H2; require dasha and transit for dates." .
career:EvidenceOffer a ar:EvidencePolicy ; ar:stableId "evidence.career.offer" ; ar:ruleText "Separate opportunity, selection and formal written offer; activity or interview evidence alone is not an offer." .
career:EvidenceJoining a ar:EvidencePolicy ; ar:stableId "evidence.career.joining" ; ar:ruleText "Separate movement, employment permission, role confirmation and actual joining execution; never equate a possible change with a joining date." .
career:EvidenceJobSecurity a ar:EvidencePolicy ; ar:stableId "evidence.career.job_security" ; ar:ruleText "Compare H6-H10 continuity and H2-H11 income support against H8-H12 disruption; pressure alone does not prove job loss." .
career:EvidenceBusiness a ar:EvidencePolicy ; ar:stableId "evidence.career.business" ; ar:ruleText "Explain clients and contracts at H7, professional execution at H10, commercial gains at H11 and resources at H2, confirmed through D1 and D10." .
career:EvidenceBusinessLaunch a ar:EvidencePolicy ; ar:stableId "evidence.career.business_launch" ; ar:ruleText "Require H3 initiative, H7 clients or contracts, H10 enterprise execution and H11 viability; use dasha and transit for launch timing." .
career:EvidenceBusinessSuccess a ar:EvidencePolicy ; ar:stableId "evidence.career.business_success" ; ar:ruleText "Trace revenue H2, clients H7, operating standing H10 and gains H11; client activity alone is not commercial success." .
career:EvidenceProject a ar:EvidencePolicy ; ar:stableId "evidence.career.project" ; ar:ruleText "Trace initiative H3, execution H6, accountable delivery H10 and outcome H11; workload alone is not successful completion." .
career:EvidenceLeadership a ar:EvidencePolicy ; ar:stableId "evidence.career.leadership" ; ar:ruleText "Judge identity H1, strategic judgment H5, guidance H9 and authority H10 through D1 and D10; do not infer leadership from the Sun alone." .
career:EvidenceGovernment a ar:EvidencePolicy ; ar:stableId "evidence.career.government" ; ar:ruleText "Separate competition and service H6, institution and merit H9, authority H10 and selection H11; require timing evidence for appointment dates." .
career:EvidenceForeignCareer a ar:EvidencePolicy ; ar:stableId "evidence.career.foreign" ; ar:ruleText "Separate movement H3, long-distance opportunity H9, profession H10 and foreign separation H12; H12 or Rahu alone is insufficient." .
career:EvidenceReturnToWork a ar:EvidencePolicy ; ar:stableId "evidence.career.return_to_work" ; ar:ruleText "Trace re-entry effort H3, employability H6, role H10 and selection or gains H11; distinguish preparation from actual return." .
career:EvidenceCareerStagnation a ar:EvidencePolicy ; ar:stableId "evidence.career.stagnation" ; ar:ruleText "Diagnose whether workload H6 is blocked by disruption H8, fails to become visibility H10, or fails to produce gains H11; do not collapse this into recognition alone." .
career:EvidenceWorkRelationship a ar:EvidencePolicy ; ar:stableId "evidence.career.work_relationship" ; ar:ruleText "Use only the target role's authored relationship houses with D10 confirmation; do not substitute generic vocation or manager rules." .

career:SectionVerdict a ar:OutputSection ; ar:sequence 1 ; skos:prefLabel "Direct answer"@en .
career:SectionReasoning a ar:OutputSection ; ar:sequence 2 ; skos:prefLabel "Astrological reasoning"@en .
career:SectionConditions a ar:OutputSection ; ar:sequence 3 ; skos:prefLabel "Opportunity and pressure"@en .
career:SectionAction a ar:OutputSection ; ar:sequence 4 ; skos:prefLabel "Practical action"@en .
career:SectionFollowUp a ar:OutputSection ; ar:sequence 5 ; skos:prefLabel "One natural follow-up question"@en .

career:ContractStaticCareer a ar:AnswerContract ; ar:stableId "contract.career.static" ;
    ar:hasOutputSection career:SectionVerdict, career:SectionReasoning, career:SectionConditions, career:SectionAction, career:SectionFollowUp .
career:ContractCareerDecision a ar:AnswerContract ; ar:stableId "contract.career.decision" ;
    ar:hasOutputSection career:SectionVerdict, career:SectionReasoning, career:SectionConditions, career:SectionAction, career:SectionFollowUp .
career:ContractCareerDiagnosis a ar:AnswerContract ; ar:stableId "contract.career.diagnosis" ;
    ar:hasOutputSection career:SectionVerdict, career:SectionReasoning, career:SectionAction, career:SectionFollowUp .
career:ContractManagerRelationship a ar:AnswerContract ; ar:stableId "contract.career.manager_relationship" ;
    ar:hasOutputSection career:SectionVerdict, career:SectionReasoning, career:SectionConditions, career:SectionAction, career:SectionFollowUp .
career:ContractCareerTiming a ar:AnswerContract ; ar:stableId "contract.career.timing" ;
    ar:hasOutputSection career:SectionVerdict, career:SectionReasoning, career:SectionConditions, career:SectionAction, career:SectionFollowUp .
career:ContractWorkRelationship a ar:AnswerContract ; ar:stableId "contract.career.work_relationship" ;
    ar:hasOutputSection career:SectionVerdict, career:SectionReasoning, career:SectionConditions, career:SectionAction, career:SectionFollowUp .

career:NoUnrequestedTiming a ar:Guardrail ; ar:stableId "guardrail.no_unrequested_timing" ;
    ar:ruleText "Static, diagnostic and relationship questions must not receive dasha, transit or dated forecasts unless the question explicitly asks when or supplies a period." .
career:NoResignationFromVocation a ar:Guardrail ; ar:stableId "guardrail.no_resignation_from_vocation" ;
    ar:ruleText "Never recommend leaving a job from career fit, vocation signature, H8 or H12 alone." .
career:SemanticIntentOnly a ar:Guardrail ; ar:stableId "guardrail.semantic_intent" ;
    ar:ruleText "The multilingual intent LLM selects the question type; this ontology does not classify natural language with keywords." .
career:NoPromotionFromVisibilityAlone a ar:Guardrail ; ar:stableId "guardrail.no_promotion_from_visibility" ;
    ar:ruleText "H10 activity alone is not a promotion; recognition requires H11 and compensation claims additionally require H2." .
career:NoSalaryFromIncomeAlone a ar:Guardrail ; ar:stableId "guardrail.no_salary_from_income_alone" ;
    ar:ruleText "H2 activation alone may describe money movement; a salary increase requires the employment-role-gains chain H2+H6+H10+H11." .
career:NoBusinessFromH7Alone a ar:Guardrail ; ar:stableId "guardrail.no_business_from_h7_alone" ;
    ar:ruleText "H7 alone does not establish business suitability; initiative, profession and viable gains must also be examined." .
career:NoOfferFromActivityAlone a ar:Guardrail ; ar:stableId "guardrail.no_offer_from_activity" ; ar:ruleText "Applications, interviews, workload or H10 visibility alone do not establish a formal job offer." .
career:NoJoiningFromChangeAlone a ar:Guardrail ; ar:stableId "guardrail.no_joining_from_change" ; ar:ruleText "H3 movement or role-change pressure alone does not establish selection or joining." .
career:NoJobLossFromPressureAlone a ar:Guardrail ; ar:stableId "guardrail.no_job_loss_from_pressure" ; ar:ruleText "H8 disruption, H12 separation or dissatisfaction alone does not prove job loss or authorize resignation." .
career:NoProjectSuccessFromWorkload a ar:Guardrail ; ar:stableId "guardrail.no_project_success_from_workload" ; ar:ruleText "H6 effort or workload alone does not establish project delivery or success." .
career:NoLeadershipFromSunAlone a ar:Guardrail ; ar:stableId "guardrail.no_leadership_from_sun" ; ar:ruleText "The Sun alone does not establish leadership suitability; H1, H5, H9, H10, D1 and D10 must be synthesized." .
career:NoGovernmentFromSunAlone a ar:Guardrail ; ar:stableId "guardrail.no_government_from_sun" ; ar:ruleText "The Sun or H10 alone does not establish government selection; service, merit, authority and gains must connect." .
career:NoForeignFromH12Alone a ar:Guardrail ; ar:stableId "guardrail.no_foreign_from_h12" ; ar:ruleText "H12 or Rahu alone does not establish a foreign job; movement, long-distance opportunity and profession must connect." .
career:NoReturnFromEffortAlone a ar:Guardrail ; ar:stableId "guardrail.no_return_from_effort" ; ar:ruleText "Preparation or applications alone do not establish a return-to-work result." .
career:RoleSpecificRelationshipOnly a ar:Guardrail ; ar:stableId "guardrail.role_specific_relationship" ; ar:ruleText "Use the named workplace counterpart's house roles; do not replace colleague, subordinate, client, partner or mentor analysis with manager or vocation analysis." .

# ---------------------------------------------------------------------------
# Career proof-of-concept question types.
# ---------------------------------------------------------------------------

career:OverallCareer a ar:QuestionType ;
    ar:stableId "career.overall" ; ar:runtimeKey "general" ;
    skos:prefLabel "Overall career"@en ;
    ar:questionExample "How is my career overall?" ;
    ar:inDomain career:Career ;
