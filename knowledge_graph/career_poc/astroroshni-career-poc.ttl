# ---------------------------------------------------------------------------
# Question-specific decision stages. Every Career question type expands to
# the human decision stages it evaluates; each stage expands to exact factors.
# ---------------------------------------------------------------------------

career:OverallFoundationStage a ar:DecisionStage ; ar:sequence 1 ; skos:prefLabel "Natal professional foundation"@en ; ar:stageRequiresFactor career:D1, career:H10 .
career:OverallExpressionStage a ar:DecisionStage ; ar:sequence 2 ; skos:prefLabel "Professional expression and work environment"@en ; ar:stageRequiresFactor career:D10, career:H6, career:H10 .
career:OverallVocationStage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "Vocation and professional ability"@en ; ar:stageRequiresFactor career:Amatyakaraka, career:Karakamsha .
career:OverallOutcomeStage a ar:DecisionStage ; ar:sequence 4 ; skos:prefLabel "Income, recognition and fulfilment"@en ; ar:stageRequiresFactor career:H2, career:H11 .

career:FitWorkFunctionStage a ar:DecisionStage ; ar:sequence 1 ; skos:prefLabel "Natural work functions and strengths"@en ; ar:stageRequiresFactor career:D1, career:D10, career:H10 .
career:FitVocationStage a ar:DecisionStage ; ar:sequence 2 ; skos:prefLabel "Jaimini vocation signature"@en ; ar:stageRequiresFactor career:Amatyakaraka, career:Karakamsha .
career:FitWorkSettingStage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "Suitable work setting"@en ; ar:stageRequiresFactor career:H6, career:H10 .
career:FitViabilityStage a ar:DecisionStage ; ar:sequence 4 ; skos:prefLabel "Income and long-term viability"@en ; ar:stageRequiresFactor career:H2, career:H11 .

career:JobContinuityStage a ar:DecisionStage ; ar:sequence 1 ; skos:prefLabel "Continuity in the current job"@en ; ar:stageRequiresFactor career:H6, career:H10 .
career:JobMovementStage a ar:DecisionStage ; ar:sequence 2 ; skos:prefLabel "Movement toward a change"@en ; ar:stageRequiresFactor career:H3, career:H10 .
career:JobSeparationStage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "Separation from the current role"@en ; ar:stageRequiresFactor career:H10, career:H12 .
career:JobLandingStage a ar:DecisionStage ; ar:sequence 4 ; skos:prefLabel "Landing and sustaining the next role"@en ; ar:stageRequiresFactor career:H2, career:H6, career:H10, career:H11 .

career:RecognitionEffortStage a ar:DecisionStage ; ar:sequence 1 ; skos:prefLabel "Effort and work performed"@en ; ar:stageRequiresFactor career:H6 .
career:RecognitionVisibilityStage a ar:DecisionStage ; ar:sequence 2 ; skos:prefLabel "Visibility and professional credit"@en ; ar:stageRequiresFactor career:H10 .
career:RecognitionRewardStage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "Recognition and goal fulfilment"@en ; ar:stageRequiresFactor career:H11 .
career:RecognitionCompensationStage a ar:DecisionStage ; ar:sequence 4 ; skos:prefLabel "Material acknowledgement"@en ; ar:stageRequiresFactor career:H2 .

career:ManagerDailyInteractionStage a ar:DecisionStage ; ar:sequence 1 ; skos:prefLabel "Daily working relationship"@en ; ar:stageRequiresFactor career:H6 .
career:ManagerGuidanceStage a ar:DecisionStage ; ar:sequence 2 ; skos:prefLabel "Manager, mentor and guidance dynamic"@en ; ar:stageRequiresFactor career:H9 .
career:ManagerAuthorityStage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "Authority, reputation and accountability"@en ; ar:stageRequiresFactor career:H10 .
career:ManagerSupportStage a ar:DecisionStage ; ar:sequence 4 ; skos:prefLabel "Support, recognition and shared goals"@en ; ar:stageRequiresFactor career:H11 .

career:SalaryIncomeStage a ar:DecisionStage ; ar:sequence 1 ; skos:prefLabel "Income and compensation movement"@en ; ar:stageRequiresFactor career:H2 .
career:SalaryEmploymentStage a ar:DecisionStage ; ar:sequence 2 ; skos:prefLabel "Employment continuity and workload"@en ; ar:stageRequiresFactor career:H6 .
career:SalaryRoleStage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "Role and responsibility basis"@en ; ar:stageRequiresFactor career:H10 .
career:SalaryGainStage a ar:DecisionStage ; ar:sequence 4 ; skos:prefLabel "Gain, approval and formal award"@en ; ar:stageRequiresFactor career:H11 .

career:PathEmploymentStage a ar:DecisionStage ; ar:sequence 1 ; skos:prefLabel "Employment and structured service"@en ; ar:stageRequiresFactor career:H6, career:H10 .
career:PathInitiativeStage a ar:DecisionStage ; ar:sequence 2 ; skos:prefLabel "Independent initiative and risk capacity"@en ; ar:stageRequiresFactor career:H3 .
career:PathEnterpriseStage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "Business, clients and partnerships"@en ; ar:stageRequiresFactor career:H7, career:H10 .
career:PathViabilityStage a ar:DecisionStage ; ar:sequence 4 ; skos:prefLabel "Income and commercial viability"@en ; ar:stageRequiresFactor career:H2, career:H11 .

career:ConflictDailyStage a ar:DecisionStage ; ar:sequence 1 ; skos:prefLabel "Daily friction, workload and competition"@en ; ar:stageRequiresFactor career:H6 .
career:ConflictManagerStage a ar:DecisionStage ; ar:sequence 2 ; skos:prefLabel "Manager, mentor or guidance conflict"@en ; ar:stageRequiresFactor career:H9 .
career:ConflictAuthorityStage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "Authority, status and reputation pressure"@en ; ar:stageRequiresFactor career:H10 .
career:ConflictTeamStage a ar:DecisionStage ; ar:sequence 4 ; skos:prefLabel "Team support, alliances and recognition"@en ; ar:stageRequiresFactor career:H11 .

