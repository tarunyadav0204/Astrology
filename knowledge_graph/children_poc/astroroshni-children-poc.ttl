@prefix ar: <https://astroroshni.com/ontology/core#> .
@prefix children: <https://astroroshni.com/ontology/children#> .
@prefix domain: <https://astroroshni.com/ontology/domain#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

children:Ontology a owl:Ontology ; rdfs:label "AstroRoshni Instant Children, Parenthood and Progeny ontology"@en ; owl:versionInfo "0.1.0" .

ar:LifeDomain a owl:Class ; rdfs:label "Life domain"@en .
ar:QuestionType a owl:Class ; rdfs:label "Question type"@en .
ar:AstrologyFactor a owl:Class ; rdfs:label "Astrology factor"@en .
ar:CalculatorCapability a owl:Class ; rdfs:label "Calculator capability"@en .
ar:AnswerMode a owl:Class ; rdfs:label "Answer mode"@en .
ar:AnswerContract a owl:Class ; rdfs:label "Answer contract"@en .
ar:EvidencePolicy a owl:Class ; rdfs:label "Evidence policy"@en .
ar:Guardrail a owl:Class ; rdfs:label "Guardrail"@en .
ar:DecisionRule a owl:Class ; rdfs:label "Decision rule"@en .
ar:DecisionStage a owl:Class ; rdfs:label "Decision stage"@en .
ar:OutputSection a owl:Class ; rdfs:label "Output section"@en .
ar:inDomain a owl:ObjectProperty ; rdfs:label "Life domain"@en .
ar:requiresFactor a owl:ObjectProperty ; rdfs:label "Required astrology factors"@en .
ar:defaultExcludesFactor a owl:ObjectProperty ; rdfs:label "Excluded by default"@en .
ar:requiresCapability a owl:ObjectProperty ; rdfs:label "Required calculator capabilities"@en .
ar:allowedAnswerMode a owl:ObjectProperty ; rdfs:label "Answer mode"@en .
ar:usesAnswerContract a owl:ObjectProperty ; rdfs:label "Answer contract"@en .
ar:hasEvidencePolicy a owl:ObjectProperty ; rdfs:label "Evidence policy"@en .
ar:hasGuardrail a owl:ObjectProperty ; rdfs:label "Guardrails"@en .
ar:evaluatesRule a owl:ObjectProperty ; rdfs:label "Decision rules"@en .
ar:evaluatesStage a owl:ObjectProperty ; rdfs:label "Decision stages"@en .
ar:stageRequiresFactor a owl:ObjectProperty ; rdfs:label "Required astrology factors"@en .
ar:hasOutputSection a owl:ObjectProperty ; rdfs:label "Output sections"@en .
ar:stableId a owl:DatatypeProperty ; rdfs:label "Stable identifier"@en .
ar:runtimeKey a owl:DatatypeProperty ; rdfs:label "Runtime key"@en .
ar:calculatorBinding a owl:DatatypeProperty ; rdfs:label "Calculator binding"@en .
ar:ruleText a owl:DatatypeProperty ; rdfs:label "Rule text"@en .
ar:sequence a owl:DatatypeProperty ; rdfs:label "Sequence"@en .

children:Children a ar:LifeDomain ; ar:stableId "children.domain.legacy_alias" ; skos:prefLabel "Children, parenthood and progeny"@en ; owl:sameAs domain:ChildrenParenthood .

# Calculated evidence factors.
children:D1 a ar:AstrologyFactor ; skos:prefLabel "D1 progeny and parenthood promise"@en .
children:D7 a ar:AstrologyFactor ; skos:prefLabel "D7 Saptamsa progeny realization"@en .
children:D10 a ar:AstrologyFactor ; skos:prefLabel "D10 career branch for parenthood-versus-career"@en .
children:H1 a ar:AstrologyFactor ; skos:prefLabel "House 1 · native readiness and negation pressure"@en .
children:H2 a ar:AstrologyFactor ; skos:prefLabel "House 2 · family expansion"@en .
children:H4 a ar:AstrologyFactor ; skos:prefLabel "House 4 · care, home and emotional base"@en .
children:H5 a ar:AstrologyFactor ; skos:prefLabel "House 5 · children and first-child promise"@en .
children:H6 a ar:AstrologyFactor ; skos:prefLabel "House 6 · treatment, routine and conflict"@en .
children:H7 a ar:AstrologyFactor ; skos:prefLabel "House 7 · third-from-fifth subsequent-child frame"@en .
children:H8 a ar:AstrologyFactor ; skos:prefLabel "House 8 · reproductive transition and intervention"@en .
children:H9 a ar:AstrologyFactor ; skos:prefLabel "House 9 · fifth-from-fifth and later-child support"@en .
children:H10 a ar:AstrologyFactor ; skos:prefLabel "House 10 · career branch and KP negation"@en .
children:H11 a ar:AstrologyFactor ; skos:prefLabel "House 11 · fulfillment and event realization"@en .
children:H12 a ar:AstrologyFactor ; skos:prefLabel "House 12 · treatment, separation and expenditure"@en .
children:JupiterKaraka a ar:AstrologyFactor ; skos:prefLabel "Jupiter progeny-karaka condition across D1 and D7"@en .
children:LordNakshatraChain a ar:AstrologyFactor ; skos:prefLabel "Relevant house-lord, nakshatra and dispositor chain"@en .
children:ChildOrderFrame a ar:AstrologyFactor ; skos:prefLabel "Explicit first and subsequent-child house progression"@en .
children:KPFructification a ar:AstrologyFactor ; skos:prefLabel "KP cusp materialization for the exact child event"@en .
children:DashaActivation a ar:AstrologyFactor ; skos:prefLabel "Dasha permission for the same child event"@en .
children:TransitConfirmation a ar:AstrologyFactor ; skos:prefLabel "Jupiter/Saturn and transit confirmation inside the dasha"@en .
children:RemedyBlueprint a ar:AstrologyFactor ; skos:prefLabel "Calculated children-domain remedy blueprint"@en .
children:ScopeBoundary a ar:AstrologyFactor ; skos:prefLabel "Structured safety, consent or specialist-flow boundary"@en .

# Executable calculator and routing capabilities.
children:CapNatal a ar:CalculatorCapability ; ar:calculatorBinding "D1 houses 2, 5, 11 and route-specific lords, occupants and aspects" ; skos:prefLabel "Calculate natal progeny promise"@en .
children:CapD7 a ar:CalculatorCapability ; ar:calculatorBinding "DivisionalChartCalculator: D7 Saptamsa houses, lords and Jupiter" ; skos:prefLabel "Calculate D7 confirmation"@en .
children:CapD10 a ar:CalculatorCapability ; ar:calculatorBinding "DivisionalChartCalculator: D10 career branch" ; skos:prefLabel "Calculate career comparison branch"@en .
children:CapLordChain a ar:CalculatorCapability ; ar:calculatorBinding "D1/D7 house-lord condition plus natal nakshatra chain" ; skos:prefLabel "Calculate lord and nakshatra chains"@en .
children:CapChildOrder a ar:CalculatorCapability ; ar:calculatorBinding "First child H5; subsequent-child H7/H9 progression with D7 confirmation" ; skos:prefLabel "Calculate child-order frames"@en .
children:CapKP a ar:CalculatorCapability ; ar:calculatorBinding "KP cusp sub-lords and planet significators for route-specific 2-5-11 realization" ; skos:prefLabel "Calculate KP fructification"@en .
children:CapDasha a ar:CalculatorCapability ; ar:calculatorBinding "Instant forward or historical event dasha scan for the exact children route" ; skos:prefLabel "Calculate dasha permission"@en .
children:CapTransit a ar:CalculatorCapability ; ar:calculatorBinding "Instant double-transit and transit activation timeline using occupation, conjunction and seventh aspect for nodes" ; skos:prefLabel "Calculate transit confirmation"@en .
children:CapRemedy a ar:CalculatorCapability ; ar:calculatorBinding "RemedyEngine calculated priority blueprint tied to the diagnosed child-domain pressure" ; skos:prefLabel "Calculate a remedy"@en .
children:CapPartnershipHandoff a ar:CalculatorCapability ; ar:calculatorBinding "Route to Partnership Analysis with two resolved charts and consent" ; skos:prefLabel "Open two-chart analysis"@en .
children:CapChildChartHandoff a ar:CalculatorCapability ; ar:calculatorBinding "Require and route to the child's own chart for child-specific claims" ; skos:prefLabel "Open child-chart analysis"@en .
children:CapMedicalHandoff a ar:CalculatorCapability ; ar:calculatorBinding "Suppress astrological diagnosis and provide pregnancy/fertility medical-safety guidance" ; skos:prefLabel "Apply medical safety boundary"@en .
children:CapMuhuratHandoff a ar:CalculatorCapability ; ar:calculatorBinding "Route shortlisted dates to dedicated Muhurat/Panchang calculation" ; skos:prefLabel "Open Muhurat flow"@en .
children:CapLegalHandoff a ar:CalculatorCapability ; ar:calculatorBinding "Route custody outcome questions to Legal domain without guaranteeing outcome" ; skos:prefLabel "Open legal analysis"@en .
children:CapSexRefusal a ar:CalculatorCapability ; ar:calculatorBinding "Refuse direct and coded fetal-sex prediction" ; skos:prefLabel "Apply fetal-sex refusal"@en .

children:ModeTopic a ar:AnswerMode ; ar:runtimeKey "topic_reading" ; skos:prefLabel "Static children reading"@en .
children:ModeCapacity a ar:AnswerMode ; ar:runtimeKey "potential_capacity" ; skos:prefLabel "Parenthood or pathway capacity"@en .
children:ModeDiagnosis a ar:AnswerMode ; ar:runtimeKey "problem_diagnosis" ; skos:prefLabel "Delay or relationship diagnosis"@en .
children:ModeTiming a ar:AnswerMode ; ar:runtimeKey "timing_window" ; skos:prefLabel "Children timing"@en .
children:ModeDecision a ar:AnswerMode ; ar:runtimeKey "decision_support" ; skos:prefLabel "Parenthood decision support"@en .
children:ModeRemedy a ar:AnswerMode ; ar:runtimeKey "remedy_action" ; skos:prefLabel "Calculated remedy"@en .
children:ModeHandoff a ar:AnswerMode ; ar:runtimeKey "handoff" ; skos:prefLabel "Specialist flow handoff"@en .
children:ModeRefusal a ar:AnswerMode ; ar:runtimeKey "safety_refusal" ; skos:prefLabel "Safety refusal"@en .

children:SectionVerdict a ar:OutputSection ; skos:prefLabel "Direct bounded answer"@en .
children:SectionD1 a ar:OutputSection ; skos:prefLabel "D1 promise"@en .
children:SectionD7 a ar:OutputSection ; skos:prefLabel "D7 confirmation or qualification"@en .
children:SectionMechanism a ar:OutputSection ; skos:prefLabel "Question-specific mechanism"@en .
children:SectionTiming a ar:OutputSection ; skos:prefLabel "Ranked dasha, KP and transit windows"@en .
children:SectionGuidance a ar:OutputSection ; skos:prefLabel "Practical next step"@en .
children:SectionBoundary a ar:OutputSection ; skos:prefLabel "Reason and correct next flow"@en .
children:ContractStatic a ar:AnswerContract ; ar:hasOutputSection children:SectionVerdict, children:SectionD1, children:SectionD7, children:SectionMechanism, children:SectionGuidance .
children:ContractTimed a ar:AnswerContract ; ar:hasOutputSection children:SectionVerdict, children:SectionD1, children:SectionD7, children:SectionMechanism, children:SectionTiming, children:SectionGuidance .
children:ContractDecision a ar:AnswerContract ; ar:hasOutputSection children:SectionVerdict, children:SectionD1, children:SectionD7, children:SectionMechanism, children:SectionGuidance .
children:ContractRemedy a ar:AnswerContract ; ar:hasOutputSection children:SectionVerdict, children:SectionMechanism, children:SectionGuidance .
children:ContractBoundary a ar:AnswerContract ; ar:hasOutputSection children:SectionVerdict, children:SectionBoundary, children:SectionGuidance .

children:EvidenceStatic a ar:EvidencePolicy ; ar:ruleText "D1 establishes the native promise; D7 confirms or qualifies the exact children route; current timing is excluded." .
children:EvidenceTimed a ar:EvidencePolicy ; ar:ruleText "A dated child event requires established D1/D7 promise, route-specific KP fructification, matching dasha permission and transit confirmation inside the requested horizon." .
children:EvidenceDiagnosis a ar:EvidencePolicy ; ar:ruleText "Separate promise, delay, negation, treatment and circumstance mechanisms across D1 and D7 before naming the dominant relative pressure." .
children:EvidenceDecision a ar:EvidencePolicy ; ar:ruleText "Compare each named life branch independently and retain medical, financial and personal agency." .
children:EvidenceRemedy a ar:EvidencePolicy ; ar:ruleText "Use only a calculated remedy linked to the dominant children-domain pressure; never present a remedy as fertility treatment." .
children:EvidenceBoundary a ar:EvidencePolicy ; ar:ruleText "Do not calculate an answer outside the native chart's scope; explain the boundary and route to the correct chart, medical, legal, partnership or Muhurat flow." .

children:NoUnrequestedTiming a ar:Guardrail ; ar:ruleText "Static questions exclude dashas, transits and dates." .
children:D1D7Required a ar:Guardrail ; ar:ruleText "D7 availability is not confirmation; synthesize its actual condition with D1." .
children:NoSinglePlacementVerdict a ar:Guardrail ; ar:ruleText "Never decide parenthood, conception, delay or relationship from one placement, planet or house." .
children:NoGuarantee a ar:Guardrail ; ar:ruleText "Never guarantee conception, pregnancy, birth, treatment success, adoption, reconciliation or number of children." .
children:DelayNotDenial a ar:Guardrail ; ar:ruleText "Never turn pressure or delay into absolute denial without an explicitly complete severe-denial adjudication; default to qualified or delayed language." .
children:NoMedicalDiagnosis a ar:Guardrail ; ar:ruleText "Astrology cannot diagnose infertility, pregnancy risk, miscarriage, symptoms or treatment outcome and cannot delay medical care." .
children:NoLossPrediction a ar:Guardrail ; ar:ruleText "Do not predict miscarriage, fetal harm or recurrence of pregnancy loss; respond without blame or karmic causation." .
children:NoSexPrediction a ar:Guardrail ; ar:ruleText "Refuse direct, indirect and coded fetal-sex or son-versus-daughter prediction." .
children:NoExactCount a ar:Guardrail ; ar:ruleText "Family-size evidence is a tendency only; never promise an exact child count or twins." .
children:ChildChartRequired a ar:Guardrail ; ar:ruleText "A parent's chart describes their experience of children, not the child's detailed personality, health, education, career, marriage or fate." .
children:TwoChartsRequired a ar:Guardrail ; ar:ruleText "Joint conception or cooperative-parenting claims require both resolved charts in Partnership Analysis." .
children:MuhuratSeparate a ar:Guardrail ; ar:ruleText "Electional dates require the dedicated Muhurat and Panchang flow; natal timing is not Panchang evidence." .
children:LegalSeparate a ar:Guardrail ; ar:ruleText "Custody outcomes require the Legal domain and cannot be guaranteed astrologically." .
children:StrictHorizon a ar:Guardrail ; ar:ruleText "Do not mention dates outside the requested horizon." .
children:NoNodeFifthNinth a ar:Guardrail ; ar:ruleText "Rahu and Ketu never use fifth or ninth aspects; retain occupation, conjunction and seventh aspect only." .
children:NoGenericRemedy a ar:Guardrail ; ar:ruleText "Do not invent a generic Jupiter, mantra, gemstone or ritual remedy when the calculated blueprint is absent." .
children:KnownDateNotDiscovered a ar:Guardrail ; ar:ruleText "A user-supplied child date may verify factors or support rectification but must never be described as independently discovered by astrology." .

children:RulePromiseFirst a ar:DecisionRule ; ar:ruleText "Judge D1 promise before D7, KP, dasha or transit realization." .
children:RuleD7Qualifies a ar:DecisionRule ; ar:ruleText "D7 confirms, qualifies or challenges how D1 children promise manifests; its mere availability is neutral." .
children:RuleTimingChain a ar:DecisionRule ; ar:ruleText "Rank timing only when the same event is supported by promise, KP, dasha and transit; separate conception from childbirth." .
children:RuleChildOrder a ar:DecisionRule ; ar:ruleText "First child uses H5; later-child analysis explicitly progresses through H7/H9 and verifies the corresponding D7 frame instead of copying the first-child result." .
children:RuleDelayMechanism a ar:DecisionRule ; ar:ruleText "Separate weak promise, temporary obstruction, treatment pathway, sustaining pressure and external circumstance; delay is not denial." .
children:RulePathwayComparison a ar:DecisionRule ; ar:ruleText "Biological, assisted, adoption and step-parenthood pathways are distinct and must be compared from their own calculated chains." .
children:RuleRelationshipScope a ar:DecisionRule ; ar:ruleText "Use the native's parenting disposition and H5/D7 relationship pattern; do not invent the child's motives or traits." .
children:RuleSafetyFirst a ar:DecisionRule ; ar:ruleText "Medical symptoms, pregnancy risk and loss concerns receive safety guidance before any optional astrological context." .
children:RuleCorrectFlow a ar:DecisionRule ; ar:ruleText "Use Partnership, child-chart, Muhurat or Legal flow whenever the requested claim requires that separate evidence." .
children:RuleRemedyCalculated a ar:DecisionRule ; ar:ruleText "A remedy must come from the calculated blueprint and be framed as spiritual support, never medical treatment or outcome assurance." .

children:NatalStage a ar:DecisionStage ; ar:sequence 1 ; skos:prefLabel "Natal progeny promise"@en ; ar:stageRequiresFactor children:D1, children:H2, children:H5, children:H11, children:JupiterKaraka, children:LordNakshatraChain .
children:D7Stage a ar:DecisionStage ; ar:sequence 2 ; skos:prefLabel "D7 Saptamsa confirmation"@en ; ar:stageRequiresFactor children:D7, children:JupiterKaraka .
children:TimingStage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "Event materialization and timing"@en ; ar:stageRequiresFactor children:KPFructification, children:DashaActivation, children:TransitConfirmation .
children:OrderStage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "Child-order progression"@en ; ar:stageRequiresFactor children:H5, children:H7, children:H9, children:ChildOrderFrame, children:D7 .
children:DelayStage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "Delay and pathway mechanism"@en ; ar:stageRequiresFactor children:H1, children:H4, children:H5, children:H8, children:H10, children:H12, children:D7 .
children:RelationshipStage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "Parent-child relationship pattern"@en ; ar:stageRequiresFactor children:H1, children:H4, children:H5, children:D7 .
children:DecisionStage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "Independent decision branches"@en ; ar:stageRequiresFactor children:D1, children:D7, children:H5, children:H10, children:H11 .
children:RemedyStage a ar:DecisionStage ; ar:sequence 4 ; skos:prefLabel "Calculated remedy selection"@en ; ar:stageRequiresFactor children:RemedyBlueprint .
children:BoundaryStage a ar:DecisionStage ; ar:sequence 1 ; skos:prefLabel "Scope and safety boundary"@en ; ar:stageRequiresFactor children:ScopeBoundary .

# Static and timing routes. Each route carries its own evidence and output contract.
children:QChildrenOverview a ar:QuestionType ; ar:runtimeKey "children_overview" ; skos:prefLabel "Overall children and parenthood promise"@en ; ar:inDomain children:Children ; ar:requiresFactor children:D1, children:D7, children:H2, children:H5, children:H11, children:JupiterKaraka, children:LordNakshatraChain ; ar:defaultExcludesFactor children:KPFructification, children:DashaActivation, children:TransitConfirmation ; ar:requiresCapability children:CapNatal, children:CapD7, children:CapLordChain ; ar:allowedAnswerMode children:ModeTopic ; ar:usesAnswerContract children:ContractStatic ; ar:hasEvidencePolicy children:EvidenceStatic ; ar:hasGuardrail children:NoUnrequestedTiming, children:D1D7Required, children:NoSinglePlacementVerdict, children:NoGuarantee ; ar:evaluatesRule children:RulePromiseFirst, children:RuleD7Qualifies ; ar:evaluatesStage children:NatalStage, children:D7Stage .
children:QParenthoodCapacity a ar:QuestionType ; ar:runtimeKey "parenthood_capacity" ; skos:prefLabel "Parenthood disposition and readiness"@en ; ar:inDomain children:Children ; ar:requiresFactor children:D1, children:D7, children:H1, children:H4, children:H5, children:JupiterKaraka ; ar:defaultExcludesFactor children:KPFructification, children:DashaActivation, children:TransitConfirmation ; ar:requiresCapability children:CapNatal, children:CapD7 ; ar:allowedAnswerMode children:ModeCapacity ; ar:usesAnswerContract children:ContractStatic ; ar:hasEvidencePolicy children:EvidenceStatic ; ar:hasGuardrail children:NoUnrequestedTiming, children:D1D7Required, children:NoGuarantee ; ar:evaluatesRule children:RulePromiseFirst, children:RuleRelationshipScope ; ar:evaluatesStage children:NatalStage, children:D7Stage, children:RelationshipStage .
children:QConceptionCapacity a ar:QuestionType ; ar:runtimeKey "conception_capacity" ; skos:prefLabel "Conception potential"@en ; ar:inDomain children:Children ; ar:requiresFactor children:D1, children:D7, children:H2, children:H5, children:H8, children:H11, children:JupiterKaraka, children:LordNakshatraChain ; ar:defaultExcludesFactor children:DashaActivation, children:TransitConfirmation ; ar:requiresCapability children:CapNatal, children:CapD7, children:CapLordChain ; ar:allowedAnswerMode children:ModeCapacity ; ar:usesAnswerContract children:ContractStatic ; ar:hasEvidencePolicy children:EvidenceStatic ; ar:hasGuardrail children:NoUnrequestedTiming, children:NoMedicalDiagnosis, children:DelayNotDenial, children:NoGuarantee ; ar:evaluatesRule children:RulePromiseFirst, children:RuleD7Qualifies ; ar:evaluatesStage children:NatalStage, children:D7Stage .
children:QConceptionTiming a ar:QuestionType ; ar:runtimeKey "conception_timing" ; skos:prefLabel "Conception timing"@en ; ar:inDomain children:Children ; ar:requiresFactor children:D1, children:D7, children:H2, children:H5, children:H11, children:JupiterKaraka, children:KPFructification, children:DashaActivation, children:TransitConfirmation ; ar:requiresCapability children:CapNatal, children:CapD7, children:CapKP, children:CapDasha, children:CapTransit ; ar:allowedAnswerMode children:ModeTiming ; ar:usesAnswerContract children:ContractTimed ; ar:hasEvidencePolicy children:EvidenceTimed ; ar:hasGuardrail children:NoGuarantee, children:NoMedicalDiagnosis, children:StrictHorizon, children:NoNodeFifthNinth ; ar:evaluatesRule children:RulePromiseFirst, children:RuleTimingChain ; ar:evaluatesStage children:NatalStage, children:D7Stage, children:TimingStage .
children:QChildbirthTiming a ar:QuestionType ; ar:runtimeKey "childbirth_timing" ; skos:prefLabel "Childbirth timing distinct from conception"@en ; ar:inDomain children:Children ; ar:requiresFactor children:D1, children:D7, children:H2, children:H5, children:H9, children:H11, children:KPFructification, children:DashaActivation, children:TransitConfirmation ; ar:requiresCapability children:CapNatal, children:CapD7, children:CapKP, children:CapDasha, children:CapTransit ; ar:allowedAnswerMode children:ModeTiming ; ar:usesAnswerContract children:ContractTimed ; ar:hasEvidencePolicy children:EvidenceTimed ; ar:hasGuardrail children:NoGuarantee, children:NoMedicalDiagnosis, children:StrictHorizon, children:NoNodeFifthNinth ; ar:evaluatesRule children:RulePromiseFirst, children:RuleTimingChain ; ar:evaluatesStage children:NatalStage, children:D7Stage, children:TimingStage .
children:QFirstChildCapacity a ar:QuestionType ; ar:runtimeKey "first_child_capacity" ; skos:prefLabel "First-child promise"@en ; ar:inDomain children:Children ; ar:requiresFactor children:D1, children:D7, children:H2, children:H5, children:H11, children:ChildOrderFrame ; ar:defaultExcludesFactor children:DashaActivation, children:TransitConfirmation ; ar:requiresCapability children:CapNatal, children:CapD7, children:CapChildOrder ; ar:allowedAnswerMode children:ModeCapacity ; ar:usesAnswerContract children:ContractStatic ; ar:hasEvidencePolicy children:EvidenceStatic ; ar:hasGuardrail children:NoUnrequestedTiming, children:NoGuarantee ; ar:evaluatesRule children:RulePromiseFirst, children:RuleChildOrder ; ar:evaluatesStage children:NatalStage, children:D7Stage, children:OrderStage .
children:QFirstChild a ar:QuestionType ; ar:runtimeKey "first_child" ; skos:prefLabel "First-child timing"@en ; ar:inDomain children:Children ; ar:requiresFactor children:D1, children:D7, children:H2, children:H5, children:H11, children:ChildOrderFrame, children:KPFructification, children:DashaActivation, children:TransitConfirmation ; ar:requiresCapability children:CapNatal, children:CapD7, children:CapChildOrder, children:CapKP, children:CapDasha, children:CapTransit ; ar:allowedAnswerMode children:ModeTiming ; ar:usesAnswerContract children:ContractTimed ; ar:hasEvidencePolicy children:EvidenceTimed ; ar:hasGuardrail children:NoGuarantee, children:StrictHorizon, children:NoNodeFifthNinth ; ar:evaluatesRule children:RuleChildOrder, children:RuleTimingChain ; ar:evaluatesStage children:NatalStage, children:D7Stage, children:OrderStage, children:TimingStage .
children:QSubsequentChildCapacity a ar:QuestionType ; ar:runtimeKey "subsequent_child_capacity" ; skos:prefLabel "Second or subsequent-child promise"@en ; ar:inDomain children:Children ; ar:requiresFactor children:D1, children:D7, children:H5, children:H7, children:H9, children:H11, children:ChildOrderFrame ; ar:defaultExcludesFactor children:DashaActivation, children:TransitConfirmation ; ar:requiresCapability children:CapNatal, children:CapD7, children:CapChildOrder ; ar:allowedAnswerMode children:ModeCapacity ; ar:usesAnswerContract children:ContractStatic ; ar:hasEvidencePolicy children:EvidenceStatic ; ar:hasGuardrail children:NoUnrequestedTiming, children:NoGuarantee, children:NoExactCount ; ar:evaluatesRule children:RuleChildOrder, children:RuleD7Qualifies ; ar:evaluatesStage children:OrderStage, children:D7Stage .
children:QSubsequentChild a ar:QuestionType ; ar:runtimeKey "subsequent_child" ; skos:prefLabel "Second or subsequent-child timing"@en ; ar:inDomain children:Children ; ar:requiresFactor children:D1, children:D7, children:H5, children:H7, children:H9, children:H11, children:ChildOrderFrame, children:KPFructification, children:DashaActivation, children:TransitConfirmation ; ar:requiresCapability children:CapNatal, children:CapD7, children:CapChildOrder, children:CapKP, children:CapDasha, children:CapTransit ; ar:allowedAnswerMode children:ModeTiming ; ar:usesAnswerContract children:ContractTimed ; ar:hasEvidencePolicy children:EvidenceTimed ; ar:hasGuardrail children:NoGuarantee, children:NoExactCount, children:StrictHorizon, children:NoNodeFifthNinth ; ar:evaluatesRule children:RuleChildOrder, children:RuleTimingChain ; ar:evaluatesStage children:OrderStage, children:TimingStage .
children:QFamilySize a ar:QuestionType ; ar:runtimeKey "family_size_tendency" ; skos:prefLabel "Family-size tendency"@en ; ar:inDomain children:Children ; ar:requiresFactor children:D1, children:D7, children:H2, children:H5, children:H7, children:H9, children:H11, children:ChildOrderFrame ; ar:defaultExcludesFactor children:DashaActivation, children:TransitConfirmation ; ar:requiresCapability children:CapNatal, children:CapD7, children:CapChildOrder ; ar:allowedAnswerMode children:ModeCapacity ; ar:usesAnswerContract children:ContractStatic ; ar:hasEvidencePolicy children:EvidenceStatic ; ar:hasGuardrail children:NoUnrequestedTiming, children:NoExactCount, children:NoGuarantee ; ar:evaluatesRule children:RuleChildOrder, children:RuleD7Qualifies ; ar:evaluatesStage children:OrderStage, children:D7Stage .
