home:CapRemedy a ar:CalculatorCapability ; ar:calculatorBinding "instant_chat_v2.home_calculation.build_home_foundation" .
home:CapBoundary a ar:CalculatorCapability ; ar:calculatorBinding "instant_chat_v2.graph_live.enforce_live_graph_answer" .
