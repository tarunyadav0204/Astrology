home:TransitConfirmation a ar:AstrologyFactor ; skos:prefLabel "Transit confirmation" .
home:RemedyBlueprint a ar:AstrologyFactor ; skos:prefLabel "Calculated remedy" .
home:ScopeBoundary a ar:AstrologyFactor ; skos:prefLabel "Dedicated-domain boundary" .
home:NatalStage a ar:DecisionStage ; ar:stageRequiresFactor home:D1, home:H4 .
home:D4Stage a ar:DecisionStage ; ar:stageRequiresFactor home:D4, home:H4 .
home:D16Stage a ar:DecisionStage ; ar:stageRequiresFactor home:D16, home:H4 .
home:TimingStage a ar:DecisionStage ; ar:stageRequiresFactor home:DashaActivation, home:KPFructification, home:TransitConfirmation .
home:FinanceStage a ar:DecisionStage ; ar:stageRequiresFactor home:H2, home:H6, home:H8, home:H11 .
home:BoundaryStage a ar:DecisionStage ; ar:stageRequiresFactor home:ScopeBoundary .
home:RemedyStage a ar:DecisionStage ; ar:stageRequiresFactor home:RemedyBlueprint .
home:CapNatal a ar:CalculatorCapability ; ar:calculatorBinding "instant_chat_v2.home_calculation.build_home_foundation" .
home:CapD4 a ar:CalculatorCapability ; ar:calculatorBinding "instant_chat_v2.home_calculation.build_home_foundation" .
home:CapD16 a ar:CalculatorCapability ; ar:calculatorBinding "instant_chat_v2.home_calculation.build_home_foundation" .
