@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

foreign:Ontology a owl:Ontology ; owl:versionInfo "0.1.0" .
ar:QuestionType a owl:Class ; rdfs:label "Question type" .
ar:DecisionStage a owl:Class ; rdfs:label "Decision stage" .
ar:AstrologyFactor a owl:Class ; rdfs:label "Astrology factor" .
ar:CalculatorCapability a owl:Class ; rdfs:label "Calculator capability" .
ar:AnswerMode a owl:Class ; rdfs:label "Answer mode" .
ar:AnswerContract a owl:Class ; rdfs:label "Answer contract" .
ar:EvidencePolicy a owl:Class ; rdfs:label "Evidence policy" .
ar:OutputSection a owl:Class ; rdfs:label "Output section" .
ar:Guardrail a owl:Class ; rdfs:label "Guardrail" .
ar:DecisionRule a owl:Class ; rdfs:label "Decision rule" .
ar:inDomain a owl:ObjectProperty ; rdfs:label "Life domain" .
ar:evaluatesStage a owl:ObjectProperty ; rdfs:label "Decision stages" .
ar:requiresFactor a owl:ObjectProperty ; rdfs:label "Required factors" .
ar:requiresCapability a owl:ObjectProperty ; rdfs:label "Calculator capabilities" .
ar:allowedAnswerMode a owl:ObjectProperty ; rdfs:label "Allowed answer mode" .
ar:usesAnswerContract a owl:ObjectProperty ; rdfs:label "Answer contract" .
ar:hasEvidencePolicy a owl:ObjectProperty ; rdfs:label "Evidence policy" .
ar:evaluatesRule a owl:ObjectProperty ; rdfs:label "Decision rules" .
ar:hasGuardrail a owl:ObjectProperty ; rdfs:label "Guardrails" .
ar:defaultExcludesFactor a owl:ObjectProperty ; rdfs:label "Default exclusions" .
ar:stageRequiresFactor a owl:ObjectProperty ; rdfs:label "Stage factors" .
ar:hasOutputSection a owl:ObjectProperty ; rdfs:label "Output sections" .
foreign:ForeignLife a ar:LifeDomain ; owl:sameAs domain:TravelRelocationForeignLife ; skos:prefLabel "Travel, Relocation and Foreign Life" .

foreign:D1 a ar:AstrologyFactor ; skos:prefLabel "D1 natal chart" .
foreign:D3 a ar:AstrologyFactor ; skos:prefLabel "D3 movement chart" .
foreign:D4 a ar:AstrologyFactor ; skos:prefLabel "D4 residence chart" .
foreign:D9 a ar:AstrologyFactor ; skos:prefLabel "D9 long-distance confirmation" .
foreign:D10 a ar:AstrologyFactor ; skos:prefLabel "D10 career pathway chart" .
foreign:D12 a ar:AstrologyFactor ; skos:prefLabel "D12 rootedness confirmation" .
foreign:H3 a ar:AstrologyFactor ; skos:prefLabel "House 3 movement and documents" .
foreign:H4 a ar:AstrologyFactor ; skos:prefLabel "House 4 home and rootedness" .
foreign:H6 a ar:AstrologyFactor ; skos:prefLabel "House 6 process and obstacles" .
foreign:H7 a ar:AstrologyFactor ; skos:prefLabel "House 7 distant others and agreements" .
foreign:H8 a ar:AstrologyFactor ; skos:prefLabel "House 8 disruption and transition" .
foreign:H9 a ar:AstrologyFactor ; skos:prefLabel "House 9 long-distance travel" .
foreign:H10 a ar:AstrologyFactor ; skos:prefLabel "House 10 career pathway" .
foreign:H11 a ar:AstrologyFactor ; skos:prefLabel "House 11 realization" .
foreign:H12 a ar:AstrologyFactor ; skos:prefLabel "House 12 separation and foreign residence" .
foreign:KPFructification a ar:AstrologyFactor ; skos:prefLabel "KP fructification" .
foreign:DashaActivation a ar:AstrologyFactor ; skos:prefLabel "Dasha activation" .
foreign:TransitConfirmation a ar:AstrologyFactor ; skos:prefLabel "Transit confirmation" .
foreign:OptionEvidence a ar:AstrologyFactor ; skos:prefLabel "Named-location option evidence" .
foreign:PathwayEvidence a ar:AstrologyFactor ; skos:prefLabel "Migration pathway evidence" .
foreign:RemedyBlueprint a ar:AstrologyFactor ; skos:prefLabel "Calculated remedy" .
foreign:ScopeBoundary a ar:AstrologyFactor ; skos:prefLabel "Dedicated-flow boundary" .

foreign:NatalStage a ar:DecisionStage ; ar:stageRequiresFactor foreign:D1, foreign:H3, foreign:H4, foreign:H9, foreign:H12 .
foreign:DivisionalStage a ar:DecisionStage ; ar:stageRequiresFactor foreign:D3, foreign:D4, foreign:D9, foreign:D12 .
foreign:TimingStage a ar:DecisionStage ; ar:stageRequiresFactor foreign:KPFructification, foreign:DashaActivation, foreign:TransitConfirmation .
foreign:BoundaryStage a ar:DecisionStage ; ar:stageRequiresFactor foreign:ScopeBoundary .
foreign:CapFoundation a ar:CalculatorCapability ; ar:calculatorBinding "instant_chat_v2.foreign_calculation.build_foreign_foundation" .
foreign:CapTiming a ar:CalculatorCapability ; ar:calculatorBinding "instant_chat_v2.foreign_graph_runtime.observed_foreign_factors" .
foreign:CapComparison a ar:CalculatorCapability ; ar:calculatorBinding "instant_chat_v2.foreign_graph_runtime.compare_foreign_graph_policy" .
foreign:CapBoundary a ar:CalculatorCapability ; ar:calculatorBinding "instant_chat_v2.graph_live.enforce_live_graph_answer" .
