foreign:ModeCapacity a ar:AnswerMode .
foreign:ModeDiagnosis a ar:AnswerMode .
foreign:ModeTiming a ar:AnswerMode .
foreign:ModeComparison a ar:AnswerMode .
foreign:ModeRemedy a ar:AnswerMode .
foreign:ModeHandoff a ar:AnswerMode .
foreign:SectionVerdict a ar:OutputSection .
foreign:SectionEvidence a ar:OutputSection .
foreign:SectionTiming a ar:OutputSection .
foreign:SectionAction a ar:OutputSection .
foreign:ContractStatic a ar:AnswerContract ; ar:hasOutputSection foreign:SectionVerdict, foreign:SectionEvidence, foreign:SectionAction .
foreign:ContractTiming a ar:AnswerContract ; ar:hasOutputSection foreign:SectionVerdict, foreign:SectionEvidence, foreign:SectionTiming, foreign:SectionAction .
foreign:ContractComparison a ar:AnswerContract ; ar:hasOutputSection foreign:SectionVerdict, foreign:SectionEvidence, foreign:SectionAction .
foreign:ContractBoundary a ar:AnswerContract ; ar:hasOutputSection foreign:SectionVerdict, foreign:SectionAction .
foreign:EvidenceStatic a ar:EvidencePolicy .
foreign:EvidenceTiming a ar:EvidencePolicy .
foreign:EvidenceBoundary a ar:EvidencePolicy .
foreign:NoUnrequestedTiming a ar:Guardrail .
foreign:NoGuarantee a ar:Guardrail .
foreign:NoH12OrRahuAlone a ar:Guardrail .
foreign:NoSettlementFromTravel a ar:Guardrail .
foreign:NoVisaApproval a ar:Guardrail .
foreign:NoLegalAdvice a ar:Guardrail .
foreign:NoSafetyGuarantee a ar:Guardrail .
foreign:NoOtherPersonClaim a ar:Guardrail .
foreign:RuleRouteCombination a ar:DecisionRule .
foreign:RuleTravelResidenceSettlementDistinct a ar:DecisionRule .
foreign:RuleTimingTriangulation a ar:DecisionRule .
foreign:RuleComparison a ar:DecisionRule .
foreign:RuleBoundary a ar:DecisionRule .

