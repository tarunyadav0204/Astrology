@prefix ar: <https://astroroshni.com/ontology/core#> .
@prefix education: <https://astroroshni.com/ontology/education#> .
@prefix domain: <https://astroroshni.com/ontology/domain#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

education:Ontology a owl:Ontology ; rdfs:label "AstroRoshni Instant Education, Exams and Research ontology"@en ; owl:versionInfo "0.2.0" .

ar:LifeDomain a owl:Class ; rdfs:label "Life domain"@en .
ar:QuestionType a owl:Class ; rdfs:label "Question type"@en .
ar:AstrologyFactor a owl:Class ; rdfs:label "Astrology factor"@en .
ar:CalculatorCapability a owl:Class ; rdfs:label "Calculator capability"@en .
ar:AnswerMode a owl:Class ; rdfs:label "Answer mode"@en .
ar:AnswerContract a owl:Class ; rdfs:label "Answer contract"@en .
ar:EvidencePolicy a owl:Class ; rdfs:label "Evidence policy"@en .
ar:Guardrail a owl:Class ; rdfs:label "Guardrail"@en .
ar:DecisionRule a owl:Class ; rdfs:label "Decision rule"@en .
ar:DecisionStage a owl:Class ; rdfs:label "Decision stage"@en .
ar:OutputSection a owl:Class ; rdfs:label "Output section"@en .
ar:inDomain a owl:ObjectProperty ; rdfs:label "Life domain"@en .
ar:requiresFactor a owl:ObjectProperty ; rdfs:label "Required astrology factors"@en .
ar:defaultExcludesFactor a owl:ObjectProperty ; rdfs:label "Excluded by default"@en .
ar:requiresCapability a owl:ObjectProperty ; rdfs:label "Required calculator capabilities"@en .
ar:allowedAnswerMode a owl:ObjectProperty ; rdfs:label "Answer mode"@en .
ar:usesAnswerContract a owl:ObjectProperty ; rdfs:label "Answer contract"@en .
ar:hasEvidencePolicy a owl:ObjectProperty ; rdfs:label "Evidence policy"@en .
ar:hasGuardrail a owl:ObjectProperty ; rdfs:label "Guardrails"@en .
ar:evaluatesRule a owl:ObjectProperty ; rdfs:label "Decision rules"@en .
ar:evaluatesStage a owl:ObjectProperty ; rdfs:label "Decision stages"@en .
ar:stageRequiresFactor a owl:ObjectProperty ; rdfs:label "Required astrology factors"@en .
ar:hasOutputSection a owl:ObjectProperty ; rdfs:label "Output sections"@en .
ar:stableId a owl:DatatypeProperty ; rdfs:label "Stable identifier"@en .
ar:runtimeKey a owl:DatatypeProperty ; rdfs:label "Runtime key"@en .
ar:calculatorBinding a owl:DatatypeProperty ; rdfs:label "Calculator binding"@en .
ar:questionExample a owl:DatatypeProperty ; rdfs:label "Question example"@en .
ar:ruleText a owl:DatatypeProperty ; rdfs:label "Rule text"@en .
ar:sequence a owl:DatatypeProperty ; rdfs:label "Sequence"@en .

education:Education a ar:LifeDomain ; ar:stableId "education.domain.legacy_alias" ; skos:prefLabel "Education, exams and research"@en ; owl:sameAs domain:EducationExamsResearch .

# Calculated factors.
education:D1 a ar:AstrologyFactor ; skos:prefLabel "D1 educational promise"@en .
education:D9 a ar:AstrologyFactor ; skos:prefLabel "D9 underlying carrier condition"@en .
education:D10 a ar:AstrologyFactor ; skos:prefLabel "D10 work-conversion evidence for education-versus-work"@en .
education:D24 a ar:AstrologyFactor ; skos:prefLabel "D24 Siddhamsha learning and scholastic depth"@en .
education:H1 a ar:AstrologyFactor ; skos:prefLabel "House 1 · learner disposition"@en .
education:H2 a ar:AstrologyFactor ; skos:prefLabel "House 2 · foundational knowledge, speech and resources"@en .
education:H3 a ar:AstrologyFactor ; skos:prefLabel "House 3 · effort, practice and applied skills"@en .
education:H4 a ar:AstrologyFactor ; skos:prefLabel "House 4 · formal education and learning foundation"@en .
education:H5 a ar:AstrologyFactor ; skos:prefLabel "House 5 · intelligence, memory, judgment and examination"@en .
education:H6 a ar:AstrologyFactor ; skos:prefLabel "House 6 · competition, routine and obstacles"@en .
education:H8 a ar:AstrologyFactor ; skos:prefLabel "House 8 · depth, research and interruption"@en .
education:H9 a ar:AstrologyFactor ; skos:prefLabel "House 9 · higher education, mentors and advanced knowledge"@en .
education:H10 a ar:AstrologyFactor ; skos:prefLabel "House 10 · qualification-to-career conversion"@en .
education:H11 a ar:AstrologyFactor ; skos:prefLabel "House 11 · admission, result and goal realization"@en .
education:H12 a ar:AstrologyFactor ; skos:prefLabel "House 12 · foreign study, isolation, expense and discontinuity"@en .
education:LearningSignificators a ar:AstrologyFactor ; skos:prefLabel "Mercury, Jupiter, Moon and route-specific significators"@en .
education:LordNakshatraChain a ar:AstrologyFactor ; skos:prefLabel "Relevant house-lord, nakshatra and dispositor chains"@en .
education:DignityStrength a ar:AstrologyFactor ; skos:prefLabel "Dignity, functional nature and strength"@en .
education:EducationYogas a ar:AstrologyFactor ; skos:prefLabel "Calculated operational education combinations"@en .
education:KPFructification a ar:AstrologyFactor ; skos:prefLabel "Route-specific KP cusp materialization"@en .
education:OptionEvidence a ar:AstrologyFactor ; skos:prefLabel "Named subject, course or work-option evidence"@en .
education:DashaActivation a ar:AstrologyFactor ; skos:prefLabel "Dasha permission for the same educational result"@en .
education:TransitConfirmation a ar:AstrologyFactor ; skos:prefLabel "Dated transit confirmation inside the permitted dasha"@en .
education:RemedyBlueprint a ar:AstrologyFactor ; skos:prefLabel "Calculated education remedy blueprint"@en .

# Executable capabilities.
education:CapNatal a ar:CalculatorCapability ; ar:calculatorBinding "D1 education houses, lords and learning significators" ; skos:prefLabel "Calculate natal education promise"@en .
education:CapD24 a ar:CalculatorCapability ; ar:calculatorBinding "DivisionalChartCalculator: D24" ; skos:prefLabel "Calculate D24 education confirmation"@en .
education:CapD9 a ar:CalculatorCapability ; ar:calculatorBinding "DivisionalChartCalculator: D9 carrier qualification" ; skos:prefLabel "Calculate D9 carrier condition"@en .
education:CapD10 a ar:CalculatorCapability ; ar:calculatorBinding "DivisionalChartCalculator: D10" ; skos:prefLabel "Calculate qualification-to-work conversion"@en .
education:CapLordChain a ar:CalculatorCapability ; ar:calculatorBinding "HouseAnalyzer and nakshatra context" ; skos:prefLabel "Calculate education lord and nakshatra chains"@en .
education:CapStrength a ar:CalculatorCapability ; ar:calculatorBinding "Planet dignity and condition analysis" ; skos:prefLabel "Calculate learning-carrier strength"@en .
education:CapKP a ar:CalculatorCapability ; ar:calculatorBinding "KP cusps 4, 5, 6, 8, 9, 11 and 12 by route" ; skos:prefLabel "Calculate route-specific educational materialization"@en .
education:CapOptions a ar:CalculatorCapability ; ar:calculatorBinding "Education option-trait comparison synthesis" ; skos:prefLabel "Compare named study or work options"@en .
education:CapDasha a ar:CalculatorCapability ; ar:calculatorBinding "Instant event horizon education-result dasha activation" ; skos:prefLabel "Calculate educational dasha permission"@en .
education:CapTransit a ar:CalculatorCapability ; ar:calculatorBinding "Instant transit activation timeline with Instant aspect policy" ; skos:prefLabel "Calculate dated education confirmation"@en .
education:CapRemedy a ar:CalculatorCapability ; ar:calculatorBinding "RemedyEngine calculated priority blueprint" ; skos:prefLabel "Calculate education remedy"@en .

education:ModeTopic a ar:AnswerMode ; ar:runtimeKey "topic_reading" ; skos:prefLabel "Static education reading"@en .
education:ModeCapacity a ar:AnswerMode ; ar:runtimeKey "potential_capacity" ; skos:prefLabel "Educational capacity or suitability"@en .
education:ModeDiagnosis a ar:AnswerMode ; ar:runtimeKey "problem_diagnosis" ; skos:prefLabel "Education obstacle diagnosis"@en .
education:ModeTiming a ar:AnswerMode ; ar:runtimeKey "timing_window" ; skos:prefLabel "Education timing"@en .
education:ModeComparison a ar:AnswerMode ; ar:runtimeKey "comparison_choice" ; skos:prefLabel "Course or pathway comparison"@en .
education:ModeDecision a ar:AnswerMode ; ar:runtimeKey "decision_support" ; skos:prefLabel "Education decision support"@en .
education:ModeRemedy a ar:AnswerMode ; ar:runtimeKey "remedy_action" ; skos:prefLabel "Calculated education remedy"@en .

education:SectionVerdict a ar:OutputSection ; skos:prefLabel "Direct answer"@en .
education:SectionFoundation a ar:OutputSection ; skos:prefLabel "D1 learning foundation"@en .
education:SectionD24 a ar:OutputSection ; skos:prefLabel "D24 confirmation or qualification"@en .
education:SectionRoute a ar:OutputSection ; skos:prefLabel "Question-specific mechanism"@en .
education:SectionOptions a ar:OutputSection ; skos:prefLabel "Option comparison"@en .
education:SectionTiming a ar:OutputSection ; skos:prefLabel "Dasha and transit window"@en .
education:SectionGuidance a ar:OutputSection ; skos:prefLabel "Practical next step"@en .
education:ContractStatic a ar:AnswerContract ; ar:hasOutputSection education:SectionVerdict, education:SectionFoundation, education:SectionD24, education:SectionRoute, education:SectionGuidance .
education:ContractTimed a ar:AnswerContract ; ar:hasOutputSection education:SectionVerdict, education:SectionFoundation, education:SectionD24, education:SectionRoute, education:SectionTiming, education:SectionGuidance .
education:ContractComparison a ar:AnswerContract ; ar:hasOutputSection education:SectionVerdict, education:SectionFoundation, education:SectionD24, education:SectionOptions, education:SectionGuidance .
education:ContractRemedy a ar:AnswerContract ; ar:hasOutputSection education:SectionVerdict, education:SectionRoute, education:SectionGuidance .

education:EvidenceStatic a ar:EvidencePolicy ; ar:ruleText "D1 establishes educational promise and D24 confirms or qualifies the exact learning route; current dashas and transits are excluded." .
education:EvidenceTimed a ar:EvidencePolicy ; ar:ruleText "A dated education result requires D1 and D24 promise, matching dasha permission, route-specific KP materialization and transit confirmation." .
education:EvidenceComparison a ar:EvidencePolicy ; ar:ruleText "Compare named options from their actual skill demands against calculated D1/D24 signatures; never invent an unnamed course." .
education:EvidenceRemedy a ar:EvidencePolicy ; ar:ruleText "Use only a calculated remedy blueprint linked to the dominant education obstacle." .

education:NoUnrequestedTiming a ar:Guardrail ; ar:ruleText "Static education questions exclude dashas, transits and dates." .
education:D1D24Required a ar:Guardrail ; ar:ruleText "D24 availability is not a positive verdict and D24 cannot replace D1; synthesize both." .
education:NoSinglePlacementVerdict a ar:Guardrail ; ar:ruleText "Never judge intelligence, success or a field from one planet or one house." .
education:NoGuaranteedResult a ar:Guardrail ; ar:ruleText "Never guarantee passing, rank, admission, scholarship, graduation or research completion." .
education:NoIntelligenceLabel a ar:Guardrail ; ar:ruleText "Do not label the user intelligent, unintelligent, disabled or incapable; describe learning conditions and strategies." .
education:NoNodeFifthNinth a ar:Guardrail ; ar:ruleText "Rahu and Ketu never use fifth or ninth aspects; retain occupation, conjunction and seventh aspect only." .
education:StrictHorizon a ar:Guardrail ; ar:ruleText "Do not mention dates outside the requested horizon." .
education:NamedOptionsOnly a ar:Guardrail ; ar:ruleText "A comparison must preserve every named option and cannot introduce or silently drop one." .
education:NoCareerOverride a ar:Guardrail ; ar:ruleText "D10 is used only for education-to-work conversion; it cannot replace D24 or turn the answer into generic career advice." .
education:ForeignStudyNotSettlement a ar:Guardrail ; ar:ruleText "Foreign-study support is not permanent immigration or settlement support." .
education:ScholarshipNotAward a ar:Guardrail ; ar:ruleText "Funding potential is not proof of a scholarship award; application quality and eligibility remain decisive." .
education:NoGenericRemedy a ar:Guardrail ; ar:ruleText "Do not invent a generic remedy when the calculated blueprint is absent." .

education:RulePromiseFirst a ar:DecisionRule ; ar:ruleText "Judge D1 promise before D24 confirmation and route-specific factors." .
education:RuleRouteSpecific a ar:DecisionRule ; ar:ruleText "Learning style, higher education, competition, admission, research and foreign study use different house and KP chains." .
education:RuleD24Qualifies a ar:DecisionRule ; ar:ruleText "D24 confirms, qualifies or challenges how natal education promise is realized; its mere presence is not support." .
education:RuleTimedChain a ar:DecisionRule ; ar:ruleText "Timing requires natal/D24 permission, matching MD-AD, optional PD narrowing, KP materialization and transit confirmation." .
education:RuleOptionFit a ar:DecisionRule ; ar:ruleText "Rank only named options by matching their declared demands with repeated D1/D24 learning signatures and practical constraints." .
education:RuleCompetitionResult a ar:DecisionRule ; ar:ruleText "Exam activity is not success; result support needs preparation/intellect houses 4/5, competition 6 and realization 11 in the same chain." .
education:RuleResearchDepth a ar:DecisionRule ; ar:ruleText "Research needs inquiry and intelligence through 5, depth through 8, advanced guidance through 9 and completion through 11." .
education:RuleObstacleMechanism a ar:DecisionRule ; ar:ruleText "Separate concentration, consistency, interruption, resource and direction problems before suggesting a response." .

education:NatalStage a ar:DecisionStage ; ar:sequence 1 ; skos:prefLabel "Natal education promise"@en ; ar:stageRequiresFactor education:D1, education:H2, education:H4, education:H5, education:H9, education:LearningSignificators, education:LordNakshatraChain, education:DignityStrength .
education:D24Stage a ar:DecisionStage ; ar:sequence 2 ; skos:prefLabel "D24 confirmation"@en ; ar:stageRequiresFactor education:D24 .
education:LearningStage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "Learning style and study method"@en ; ar:stageRequiresFactor education:H1, education:H2, education:H3, education:H4, education:H5, education:LearningSignificators .
education:FieldStage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "Subject and course fit"@en ; ar:stageRequiresFactor education:H2, education:H5, education:H9, education:H10, education:OptionEvidence .
education:HigherStage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "Higher education"@en ; ar:stageRequiresFactor education:H9, education:H5, education:H11 .
education:ExamStage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "Exam and competitive result"@en ; ar:stageRequiresFactor education:H5, education:H6, education:H11, education:H9, education:KPFructification .
education:AdmissionStage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "Admission and institutional selection"@en ; ar:stageRequiresFactor education:H4, education:H5, education:H9, education:H11, education:KPFructification .
education:ResearchStage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "Research depth and completion"@en ; ar:stageRequiresFactor education:H5, education:H8, education:H9, education:H11, education:H12 .
education:ForeignStage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "Foreign-study route"@en ; ar:stageRequiresFactor education:H9, education:H12, education:H11, education:H3 .
education:ObstacleStage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "Education obstacle diagnosis"@en ; ar:stageRequiresFactor education:H2, education:H3, education:H4, education:H5, education:H6, education:H8, education:H9, education:H11, education:H12 .
education:WorkStage a ar:DecisionStage ; ar:sequence 4 ; skos:prefLabel "Education versus work conversion"@en ; ar:stageRequiresFactor education:D10, education:H6, education:H10, education:H11, education:OptionEvidence .
education:DashaStage a ar:DecisionStage ; ar:sequence 8 ; skos:prefLabel "Dasha permission"@en ; ar:stageRequiresFactor education:DashaActivation .
education:TransitStage a ar:DecisionStage ; ar:sequence 9 ; skos:prefLabel "Transit confirmation"@en ; ar:stageRequiresFactor education:TransitConfirmation .
education:RemedyStage a ar:DecisionStage ; ar:sequence 10 ; skos:prefLabel "Calculated remedy"@en ; ar:stageRequiresFactor education:RemedyBlueprint .

# Question types. Static routes deliberately exclude timing factors.
education:OverallEducation a ar:QuestionType ; ar:stableId "education.overall" ; ar:runtimeKey "education" ; skos:prefLabel "Overall education potential"@en ; ar:questionExample "What does my chart show about my education?" ; ar:inDomain education:Education ; ar:requiresFactor education:D1, education:D24, education:H2, education:H4, education:H5, education:H9, education:H11, education:LearningSignificators, education:LordNakshatraChain, education:DignityStrength ; ar:defaultExcludesFactor education:DashaActivation, education:TransitConfirmation ; ar:requiresCapability education:CapNatal, education:CapD24, education:CapLordChain, education:CapStrength ; ar:allowedAnswerMode education:ModeTopic ; ar:usesAnswerContract education:ContractStatic ; ar:hasEvidencePolicy education:EvidenceStatic ; ar:evaluatesRule education:RulePromiseFirst, education:RuleD24Qualifies ; ar:evaluatesStage education:NatalStage, education:D24Stage ; ar:hasGuardrail education:NoUnrequestedTiming, education:D1D24Required, education:NoSinglePlacementVerdict, education:NoIntelligenceLabel .
education:EducationTiming a ar:QuestionType ; ar:stableId "education.timing" ; ar:runtimeKey "education_timing" ; skos:prefLabel "General education progress timing"@en ; ar:questionExample "Which periods are supportive for my studies?" ; ar:inDomain education:Education ; ar:requiresFactor education:D1, education:D24, education:H4, education:H5, education:H9, education:H11, education:KPFructification, education:DashaActivation, education:TransitConfirmation ; ar:requiresCapability education:CapNatal, education:CapD24, education:CapKP, education:CapDasha, education:CapTransit ; ar:allowedAnswerMode education:ModeTiming ; ar:usesAnswerContract education:ContractTimed ; ar:hasEvidencePolicy education:EvidenceTimed ; ar:evaluatesRule education:RulePromiseFirst, education:RuleTimedChain ; ar:evaluatesStage education:NatalStage, education:D24Stage, education:DashaStage, education:TransitStage ; ar:hasGuardrail education:D1D24Required, education:NoGuaranteedResult, education:NoNodeFifthNinth, education:StrictHorizon .
education:LearningStyle a ar:QuestionType ; ar:stableId "education.learning_style" ; ar:runtimeKey "learning_style" ; skos:prefLabel "Learning style and study method"@en ; ar:questionExample "How do I learn and retain information best?" ; ar:inDomain education:Education ; ar:requiresFactor education:D1, education:D24, education:H1, education:H2, education:H3, education:H4, education:H5, education:LearningSignificators ; ar:defaultExcludesFactor education:DashaActivation, education:TransitConfirmation ; ar:requiresCapability education:CapNatal, education:CapD24 ; ar:allowedAnswerMode education:ModeCapacity ; ar:usesAnswerContract education:ContractStatic ; ar:hasEvidencePolicy education:EvidenceStatic ; ar:evaluatesRule education:RuleRouteSpecific, education:RuleD24Qualifies ; ar:evaluatesStage education:LearningStage, education:D24Stage ; ar:hasGuardrail education:NoUnrequestedTiming, education:NoSinglePlacementVerdict, education:NoIntelligenceLabel .
education:SubjectFit a ar:QuestionType ; ar:stableId "education.subject_fit" ; ar:runtimeKey "subject_fit" ; skos:prefLabel "Strongest subject or field fit"@en ; ar:questionExample "Which subjects suit me best?" ; ar:inDomain education:Education ; ar:requiresFactor education:D1, education:D24, education:H5, education:H9, education:H10, education:H2, education:LearningSignificators, education:OptionEvidence ; ar:defaultExcludesFactor education:H4, education:DashaActivation, education:TransitConfirmation ; ar:requiresCapability education:CapNatal, education:CapD24, education:CapOptions ; ar:allowedAnswerMode education:ModeCapacity ; ar:usesAnswerContract education:ContractStatic ; ar:hasEvidencePolicy education:EvidenceComparison ; ar:evaluatesRule education:RuleOptionFit, education:RuleD24Qualifies ; ar:evaluatesStage education:FieldStage, education:D24Stage ; ar:hasGuardrail education:NoUnrequestedTiming, education:NoSinglePlacementVerdict, education:NoCareerOverride .
education:CourseComparison a ar:QuestionType ; ar:stableId "education.course_comparison" ; ar:runtimeKey "course_comparison" ; skos:prefLabel "Named course or stream comparison"@en ; ar:questionExample "Should I study engineering or design?" ; ar:inDomain education:Education ; ar:requiresFactor education:D1, education:D24, education:H5, education:H9, education:H10, education:H11, education:H2, education:OptionEvidence ; ar:defaultExcludesFactor education:H4, education:DashaActivation, education:TransitConfirmation ; ar:requiresCapability education:CapNatal, education:CapD24, education:CapOptions ; ar:allowedAnswerMode education:ModeComparison ; ar:usesAnswerContract education:ContractComparison ; ar:hasEvidencePolicy education:EvidenceComparison ; ar:evaluatesRule education:RuleOptionFit, education:RuleD24Qualifies ; ar:evaluatesStage education:FieldStage, education:D24Stage ; ar:hasGuardrail education:NamedOptionsOnly, education:NoUnrequestedTiming, education:NoCareerOverride .
education:HigherEducation a ar:QuestionType ; ar:stableId "education.higher" ; ar:runtimeKey "higher_education" ; skos:prefLabel "Higher education, Masters or PhD potential"@en ; ar:questionExample "Does my chart support higher studies or a PhD?" ; ar:inDomain education:Education ; ar:requiresFactor education:D1, education:D24, education:H9, education:H5, education:H11, education:LearningSignificators ; ar:defaultExcludesFactor education:H4, education:DashaActivation, education:TransitConfirmation ; ar:requiresCapability education:CapNatal, education:CapD24 ; ar:allowedAnswerMode education:ModeCapacity ; ar:usesAnswerContract education:ContractStatic ; ar:hasEvidencePolicy education:EvidenceStatic ; ar:evaluatesRule education:RulePromiseFirst, education:RuleRouteSpecific, education:RuleD24Qualifies ; ar:evaluatesStage education:HigherStage, education:D24Stage ; ar:hasGuardrail education:NoUnrequestedTiming, education:D1D24Required, education:NoGuaranteedResult .
education:HigherEducationTiming a ar:QuestionType ; ar:stableId "education.higher_timing" ; ar:runtimeKey "higher_education_timing" ; skos:prefLabel "Higher-education timing"@en ; ar:questionExample "When is higher study most supported?" ; ar:inDomain education:Education ; ar:requiresFactor education:D1, education:D24, education:H9, education:H5, education:H11, education:KPFructification, education:DashaActivation, education:TransitConfirmation ; ar:defaultExcludesFactor education:H4 ; ar:requiresCapability education:CapNatal, education:CapD24, education:CapKP, education:CapDasha, education:CapTransit ; ar:allowedAnswerMode education:ModeTiming ; ar:usesAnswerContract education:ContractTimed ; ar:hasEvidencePolicy education:EvidenceTimed ; ar:evaluatesRule education:RuleRouteSpecific, education:RuleTimedChain ; ar:evaluatesStage education:HigherStage, education:DashaStage, education:TransitStage ; ar:hasGuardrail education:D1D24Required, education:NoGuaranteedResult, education:NoNodeFifthNinth, education:StrictHorizon .
education:ExamCapacity a ar:QuestionType ; ar:stableId "education.exam" ; ar:runtimeKey "exam_capacity" ; skos:prefLabel "Exam and competitive-exam capacity"@en ; ar:questionExample "What does my chart show about competitive exams?" ; ar:inDomain education:Education ; ar:requiresFactor education:D1, education:D24, education:H5, education:H6, education:H11, education:H9, education:LearningSignificators, education:KPFructification ; ar:defaultExcludesFactor education:H4, education:DashaActivation, education:TransitConfirmation ; ar:requiresCapability education:CapNatal, education:CapD24, education:CapKP ; ar:allowedAnswerMode education:ModeCapacity ; ar:usesAnswerContract education:ContractStatic ; ar:hasEvidencePolicy education:EvidenceStatic ; ar:evaluatesRule education:RuleRouteSpecific, education:RuleCompetitionResult, education:RuleD24Qualifies ; ar:evaluatesStage education:ExamStage, education:D24Stage ; ar:hasGuardrail education:NoUnrequestedTiming, education:NoGuaranteedResult, education:NoIntelligenceLabel .
education:ExamTiming a ar:QuestionType ; ar:stableId "education.exam_timing" ; ar:runtimeKey "exam_timing" ; skos:prefLabel "Specific exam, result or competitive-selection timing"@en ; ar:questionExample "Will I clear this exam this year?" ; ar:inDomain education:Education ; ar:requiresFactor education:D1, education:D24, education:H5, education:H6, education:H11, education:H9, education:KPFructification, education:DashaActivation, education:TransitConfirmation ; ar:defaultExcludesFactor education:H4 ; ar:requiresCapability education:CapNatal, education:CapD24, education:CapKP, education:CapDasha, education:CapTransit ; ar:allowedAnswerMode education:ModeTiming ; ar:usesAnswerContract education:ContractTimed ; ar:hasEvidencePolicy education:EvidenceTimed ; ar:evaluatesRule education:RuleCompetitionResult, education:RuleTimedChain ; ar:evaluatesStage education:ExamStage, education:DashaStage, education:TransitStage ; ar:hasGuardrail education:NoGuaranteedResult, education:NoNodeFifthNinth, education:StrictHorizon .
education:AdmissionCapacity a ar:QuestionType ; ar:stableId "education.admission" ; ar:runtimeKey "admission_capacity" ; skos:prefLabel "Admission and selection potential"@en ; ar:questionExample "Does my chart support admission to a selective program?" ; ar:inDomain education:Education ; ar:requiresFactor education:D1, education:D24, education:H4, education:H5, education:H9, education:H11, education:KPFructification ; ar:defaultExcludesFactor education:DashaActivation, education:TransitConfirmation ; ar:requiresCapability education:CapNatal, education:CapD24, education:CapKP ; ar:allowedAnswerMode education:ModeCapacity ; ar:usesAnswerContract education:ContractStatic ; ar:hasEvidencePolicy education:EvidenceStatic ; ar:evaluatesRule education:RuleRouteSpecific, education:RuleD24Qualifies ; ar:evaluatesStage education:AdmissionStage, education:D24Stage ; ar:hasGuardrail education:NoUnrequestedTiming, education:NoGuaranteedResult .
education:AdmissionTiming a ar:QuestionType ; ar:stableId "education.admission_timing" ; ar:runtimeKey "admission_timing" ; skos:prefLabel "Admission or selection timing"@en ; ar:questionExample "When is admission most likely to move forward?" ; ar:inDomain education:Education ; ar:requiresFactor education:D1, education:D24, education:H4, education:H5, education:H6, education:H9, education:H11, education:KPFructification, education:DashaActivation, education:TransitConfirmation ; ar:requiresCapability education:CapNatal, education:CapD24, education:CapKP, education:CapDasha, education:CapTransit ; ar:allowedAnswerMode education:ModeTiming ; ar:usesAnswerContract education:ContractTimed ; ar:hasEvidencePolicy education:EvidenceTimed ; ar:evaluatesRule education:RuleCompetitionResult, education:RuleTimedChain ; ar:evaluatesStage education:AdmissionStage, education:DashaStage, education:TransitStage ; ar:hasGuardrail education:NoGuaranteedResult, education:NoNodeFifthNinth, education:StrictHorizon .
