@prefix ar: <https://astroroshni.com/ontology/core#> .
@prefix marriage: <https://astroroshni.com/ontology/marriage#> .
@prefix domain: <https://astroroshni.com/ontology/domain#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

marriage:Ontology a owl:Ontology ; rdfs:label "AstroRoshni Instant Marriage and Relationship ontology"@en ; owl:versionInfo "0.3.6" .

# Shared authoring vocabulary retained in each independently publishable module.
ar:LifeDomain a owl:Class ; rdfs:label "Life domain"@en .
ar:QuestionType a owl:Class ; rdfs:label "Question type"@en .
ar:AstrologyFactor a owl:Class ; rdfs:label "Astrology factor"@en .
ar:CalculatorCapability a owl:Class ; rdfs:label "Calculator capability"@en .
ar:AnswerMode a owl:Class ; rdfs:label "Answer mode"@en .
ar:AnswerContract a owl:Class ; rdfs:label "Answer contract"@en .
ar:EvidencePolicy a owl:Class ; rdfs:label "Evidence policy"@en .
ar:Guardrail a owl:Class ; rdfs:label "Guardrail"@en .
ar:DecisionRule a owl:Class ; rdfs:label "Decision rule"@en .
ar:DecisionStage a owl:Class ; rdfs:label "Decision stage"@en .
ar:OutputSection a owl:Class ; rdfs:label "Output section"@en .
ar:inDomain a owl:ObjectProperty ; rdfs:label "Life domain"@en .
ar:requiresFactor a owl:ObjectProperty ; rdfs:label "Required astrology factors"@en .
ar:defaultExcludesFactor a owl:ObjectProperty ; rdfs:label "Excluded by default"@en .
ar:requiresCapability a owl:ObjectProperty ; rdfs:label "Required calculator capabilities"@en .
ar:allowedAnswerMode a owl:ObjectProperty ; rdfs:label "Answer mode"@en .
ar:usesAnswerContract a owl:ObjectProperty ; rdfs:label "Answer contract"@en .
ar:hasEvidencePolicy a owl:ObjectProperty ; rdfs:label "Evidence policy"@en .
ar:hasGuardrail a owl:ObjectProperty ; rdfs:label "Guardrails"@en .
ar:evaluatesRule a owl:ObjectProperty ; rdfs:label "Decision rules"@en .
ar:evaluatesStage a owl:ObjectProperty ; rdfs:label "Decision stages"@en .
ar:stageRequiresFactor a owl:ObjectProperty ; rdfs:label "Required astrology factors"@en .
ar:hasOutputSection a owl:ObjectProperty ; rdfs:label "Output sections"@en .
ar:stableId a owl:DatatypeProperty ; rdfs:label "Stable identifier"@en .
ar:runtimeKey a owl:DatatypeProperty ; rdfs:label "Runtime key"@en .
ar:calculatorBinding a owl:DatatypeProperty ; rdfs:label "Calculator binding"@en .
ar:questionExample a owl:DatatypeProperty ; rdfs:label "Question example"@en .
ar:ruleText a owl:DatatypeProperty ; rdfs:label "Rule text"@en .
ar:sequence a owl:DatatypeProperty ; rdfs:label "Sequence"@en .
ar:overrideCondition a owl:DatatypeProperty ; rdfs:label "Override condition"@en .

marriage:MarriageRelationship a ar:LifeDomain ; ar:stableId "marriage.domain.legacy_alias" ; skos:prefLabel "Marriage and relationships"@en ; owl:sameAs domain:MarriageRelationships .

# Evidence factors already calculated by Instant Chat.
marriage:D1 a ar:AstrologyFactor ; skos:prefLabel "D1 natal partnership foundation"@en .
marriage:D9 a ar:AstrologyFactor ; skos:prefLabel "D9 marriage and relationship confirmation"@en .
marriage:H2 a ar:AstrologyFactor ; skos:prefLabel "House 2 · family continuity"@en .
marriage:H5 a ar:AstrologyFactor ; skos:prefLabel "House 5 · romance and affection"@en .
marriage:H7 a ar:AstrologyFactor ; skos:prefLabel "House 7 · committed partnership"@en .
marriage:H8 a ar:AstrologyFactor ; skos:prefLabel "House 8 · intimacy, strain and shared change"@en .
marriage:H11 a ar:AstrologyFactor ; skos:prefLabel "House 11 · fulfilment and continuity"@en .
marriage:H12 a ar:AstrologyFactor ; skos:prefLabel "House 12 · distance, withdrawal and separation"@en .
marriage:H3 a ar:AstrologyFactor ; skos:prefLabel "House 3 · initiative, communication and meeting channels"@en .
marriage:H4 a ar:AstrologyFactor ; skos:prefLabel "House 4 · home, roots and settlement context"@en .
marriage:H6 a ar:AstrologyFactor ; skos:prefLabel "House 6 · conflict, secrecy disputes and competing obligations"@en .
marriage:H9 a ar:AstrologyFactor ; skos:prefLabel "House 9 · ceremony, social framework and long-distance context"@en .
marriage:H10 a ar:AstrologyFactor ; skos:prefLabel "House 10 · spouse profession, status and public role"@en .
marriage:SeventhLord a ar:AstrologyFactor ; skos:prefLabel "Seventh house, lord, occupants and aspects"@en .
marriage:VenusJupiter a ar:AstrologyFactor ; skos:prefLabel "Venus and Jupiter relationship significators"@en .
marriage:DarakarakaUpapada a ar:AstrologyFactor ; skos:prefLabel "Darakaraka and Upapada support"@en .
marriage:Darakaraka a ar:AstrologyFactor ; skos:prefLabel "Darakaraka spouse archetype with rashi and nakshatra"@en .
marriage:SeventhLordNakshatra a ar:AstrologyFactor ; skos:prefLabel "Seventh-lord rashi, nakshatra, lord and pada"@en .
marriage:VenusRashiNakshatra a ar:AstrologyFactor ; skos:prefLabel "Venus rashi, nakshatra, lord and pada"@en .
marriage:KpSeventh a ar:AstrologyFactor ; skos:prefLabel "KP seventh-cusp chain and active houses"@en .
marriage:DerivedSpouseFrame a ar:AstrologyFactor ; skos:prefLabel "Derived spouse frame from the native's chart"@en .
marriage:DashaActivation a ar:AstrologyFactor ; skos:prefLabel "Dasha permission for the same relationship outcome"@en .
marriage:TransitConfirmation a ar:AstrologyFactor ; skos:prefLabel "Dated transit delivery confirmation"@en .
marriage:RelationshipContext a ar:AstrologyFactor ; skos:prefLabel "Clarified current relationship status and subject"@en .
marriage:SecondChart a ar:AstrologyFactor ; skos:prefLabel "Resolved second person's birth chart"@en .
marriage:PriorMarriageContext a ar:AstrologyFactor ; skos:prefLabel "Verified prior-marriage and present legal relationship context"@en .
marriage:MuhuratInputs a ar:AstrologyFactor ; skos:prefLabel "Marriage event, usable date range and resolved location/timezone"@en .
marriage:RemedyBlueprint a ar:AstrologyFactor ; skos:prefLabel "Calculated marriage-specific remedy blueprint"@en .

# Runtime calculator bindings.
marriage:CapMarriagePromise a ar:CalculatorCapability ; ar:stableId "marriage.cap.promise" ; ar:calculatorBinding "instant_chat_v2.methodology: parashari.marriage_promise" ; skos:prefLabel "Calculate marriage promise"@en .
marriage:CapRelationshipFoundation a ar:CalculatorCapability ; ar:stableId "marriage.cap.relationship" ; ar:calculatorBinding "instant_chat_v2.methodology: parashari.relationship_foundation" ; skos:prefLabel "Calculate relationship foundation"@en .
marriage:CapD9 a ar:CalculatorCapability ; ar:stableId "marriage.cap.d9" ; ar:calculatorBinding "instant_chat_v2.methodology: parashari.d9_confirmation" ; skos:prefLabel "Calculate D9 confirmation"@en .
marriage:CapKpSeventh a ar:CalculatorCapability ; ar:stableId "marriage.cap.kp7" ; ar:calculatorBinding "instant_chat_v2.methodology: kp.seventh_cusp_chain and kp.active_houses" ; skos:prefLabel "Calculate KP seventh-cusp evidence"@en .
marriage:CapJaimini a ar:CalculatorCapability ; ar:stableId "marriage.cap.jaimini" ; ar:calculatorBinding "instant_chat_v2.methodology: jaimini.darakaraka_upapada when exposed" ; skos:prefLabel "Calculate Darakaraka and Upapada support"@en .
marriage:CapDashaWindows a ar:CalculatorCapability ; ar:stableId "marriage.cap.dasha" ; ar:calculatorBinding "instant event horizon: parashari.dasha_windows" ; skos:prefLabel "Calculate relationship dasha windows"@en .
marriage:CapHistoricalMarriageWindows a ar:CalculatorCapability ; ar:stableId "marriage.cap.history" ; ar:calculatorBinding "instant retrospective event scan: historical_event_dasha_scan with historical transit reinforcement" ; skos:prefLabel "Calculate probable past marriage periods"@en .
marriage:CapTransitTriggers a ar:CalculatorCapability ; ar:stableId "marriage.cap.transit" ; ar:calculatorBinding "instant transit activation timeline: marriage and relationship triggers" ; skos:prefLabel "Calculate dated relationship triggers"@en .
marriage:CapDerivedSpouse a ar:CalculatorCapability ; ar:stableId "marriage.cap.spouse" ; ar:calculatorBinding "instant_chat_pipeline: person_profile_axes with spouse derived-house frame" ; skos:prefLabel "Calculate spouse profile from the native's chart"@en .
marriage:CapSpouseTemperament a ar:CalculatorCapability ; ar:stableId "marriage.cap.spouse_temperament" ; ar:calculatorBinding "instant_chat_pipeline: spouse_temperament_context with seventh house/lord, nakshatras, Darakaraka, Venus and D9" ; skos:prefLabel "Calculate five-layer spouse temperament synthesis"@en .
marriage:CapSpouseAppearance a ar:CalculatorCapability ; ar:stableId "marriage.cap.spouse_appearance" ; ar:calculatorBinding "instant_chat_pipeline: spouse_appearance_context with seventh-house rashi, seventh-lord nakshatra, Darakaraka, Venus and D9" ; skos:prefLabel "Calculate bounded spouse appearance indications"@en .
marriage:CapSpouseLocation a ar:CalculatorCapability ; ar:stableId "marriage.cap.spouse_location" ; ar:calculatorBinding "instant_chat_pipeline: spouse_location_context scoring direct spouse links to houses 3, 4, 9 and 12 plus explicit Rahu linkage" ; skos:prefLabel "Calculate spouse local-versus-different-background tendency"@en .
marriage:CapClarifyStatus a ar:CalculatorCapability ; ar:stableId "marriage.cap.context" ; ar:calculatorBinding "instant_chat_v2 planner: target and relationship-status clarification" ; skos:prefLabel "Resolve relationship status and subject"@en .
marriage:CapPartnershipHandoff a ar:CalculatorCapability ; ar:stableId "marriage.cap.compatibility" ; ar:calculatorBinding "intent_router: dedicated_partnership_flow handoff requiring two charts" ; skos:prefLabel "Handoff two-chart compatibility"@en .
marriage:CapMarriageRemedies a ar:CalculatorCapability ; ar:stableId "marriage.cap.remedies" ; ar:calculatorBinding "instant_chat_pipeline: RemedyEngine marriage-focused remedy_blueprint" ; skos:prefLabel "Calculate marriage-specific remedies"@en .
marriage:CapMarriageChoice a ar:CalculatorCapability ; ar:stableId "marriage.cap.choice" ; ar:calculatorBinding "instant query planner: option-specific love-versus-arranged comparison using D1 and D9" ; skos:prefLabel "Compare love and arranged marriage pathways"@en .
marriage:CapRemarriage a ar:CalculatorCapability ; ar:stableId "marriage.cap.remarriage" ; ar:calculatorBinding "instant event horizon: remarriage promise with prior-marriage context, dasha windows and transit triggers" ; skos:prefLabel "Calculate remarriage promise and timing"@en .
marriage:CapMarriageMilestones a ar:CalculatorCapability ; ar:stableId "marriage.cap.milestones" ; ar:calculatorBinding "instant event horizon: separate engagement and wedding event windows" ; skos:prefLabel "Calculate engagement and wedding milestones separately"@en .
marriage:CapSpouseMeeting a ar:CalculatorCapability ; ar:stableId "marriage.cap.meeting" ; ar:calculatorBinding "instant_chat_pipeline: natal seventh-lord destination plus D1 house-channel and D9 meeting context" ; skos:prefLabel "Calculate probable spouse meeting context"@en .
marriage:CapSpouseDetails a ar:CalculatorCapability ; ar:stableId "marriage.cap.spouse_details" ; ar:calculatorBinding "instant_chat_pipeline: person_profile_axes with profession, location and appearance scopes" ; skos:prefLabel "Calculate detailed spouse indications"@en .
marriage:CapAffairAssessment a ar:CalculatorCapability ; ar:stableId "marriage.cap.affair" ; ar:calculatorBinding "instant relationship diagnosis: attraction, secrecy, conflict and continuity evidence" ; skos:prefLabel "Assess affair concerns without asserting betrayal"@en .
marriage:CapMarriageMuhurat a ar:CalculatorCapability ; ar:stableId "marriage.cap.muhurat" ; ar:calculatorBinding "panchang.muhurat_calculator: calculate_vivah_muhurat through dedicated_muhurat_flow" ; skos:prefLabel "Calculate marriage Muhurat slots"@en .
marriage:CapPartnershipAnalysis a ar:CalculatorCapability ; ar:stableId "marriage.cap.partnership_analysis" ; ar:calculatorBinding "dedicated Partnership Analysis: resolved native and partner D1/D9 comparison" ; skos:prefLabel "Calculate actual two-chart compatibility"@en .

# Answer modes and contracts.
marriage:ModePromise a ar:AnswerMode ; ar:runtimeKey "potential_capacity" ; skos:prefLabel "Natal marriage-promise assessment"@en .
marriage:ModeOutlook a ar:AnswerMode ; ar:runtimeKey "topic_reading" ; skos:prefLabel "Marriage or relationship outlook"@en .
marriage:ModeTiming a ar:AnswerMode ; ar:runtimeKey "event_prediction" ; skos:prefLabel "Marriage or relationship timing"@en .
marriage:ModeRetrospective a ar:AnswerMode ; ar:runtimeKey "event_prediction" ; skos:prefLabel "Retrospective marriage-event discovery"@en .
marriage:ModeProfile a ar:AnswerMode ; ar:runtimeKey "relationship_person" ; skos:prefLabel "Derived spouse profile"@en .
marriage:ModeDiagnosis a ar:AnswerMode ; ar:runtimeKey "problem_diagnosis" ; skos:prefLabel "Relationship problem diagnosis"@en .
marriage:ModeRemedy a ar:AnswerMode ; ar:runtimeKey "remedy_action" ; skos:prefLabel "Marriage-specific remedy plan"@en .
marriage:ModeChoice a ar:AnswerMode ; ar:runtimeKey "comparison_choice" ; skos:prefLabel "Love versus arranged marriage comparison"@en .
marriage:ModeRemarriage a ar:AnswerMode ; ar:runtimeKey "event_prediction" ; skos:prefLabel "Second-marriage or remarriage assessment"@en .
marriage:ModeMilestone a ar:AnswerMode ; ar:runtimeKey "event_prediction" ; skos:prefLabel "Engagement and wedding milestone timing"@en .
marriage:ModeMeeting a ar:AnswerMode ; ar:runtimeKey "topic_reading" ; skos:prefLabel "Probable spouse meeting context"@en .
marriage:ModeDetailedProfile a ar:AnswerMode ; ar:runtimeKey "relationship_person" ; skos:prefLabel "Detailed spouse profile"@en .
marriage:ModeAffair a ar:AnswerMode ; ar:runtimeKey "problem_diagnosis" ; skos:prefLabel "Affair or third-party concern assessment"@en .
marriage:ModeMuhurat a ar:AnswerMode ; ar:runtimeKey "dedicated_muhurat_flow" ; skos:prefLabel "Dedicated marriage Muhurat calculation"@en .
marriage:ModeCompatibility a ar:AnswerMode ; ar:runtimeKey "dedicated_partnership_flow" ; skos:prefLabel "Two-chart compatibility handoff"@en .

marriage:SectionVerdict a ar:OutputSection ; skos:prefLabel "Direct verdict"@en .
marriage:SectionFoundation a ar:OutputSection ; skos:prefLabel "Natal and D9 foundation"@en .
marriage:SectionMechanism a ar:OutputSection ; skos:prefLabel "Support and friction mechanisms"@en .
marriage:SectionTiming a ar:OutputSection ; skos:prefLabel "Ranked supported windows"@en .
marriage:SectionGuidance a ar:OutputSection ; skos:prefLabel "Practical relationship guidance"@en .
marriage:SectionClarification a ar:OutputSection ; skos:prefLabel "One material clarification"@en .
marriage:ContractStatic a ar:AnswerContract ; ar:stableId "marriage.contract.static" ; skos:prefLabel "Static relationship answer"@en ; ar:hasOutputSection marriage:SectionVerdict, marriage:SectionFoundation, marriage:SectionMechanism, marriage:SectionGuidance, marriage:SectionClarification .
marriage:ContractTimed a ar:AnswerContract ; ar:stableId "marriage.contract.timed" ; skos:prefLabel "Timed relationship answer"@en ; ar:hasOutputSection marriage:SectionVerdict, marriage:SectionFoundation, marriage:SectionMechanism, marriage:SectionTiming, marriage:SectionGuidance, marriage:SectionClarification .
marriage:ContractProfile a ar:AnswerContract ; ar:stableId "marriage.contract.profile" ; skos:prefLabel "Derived spouse-profile answer"@en ; ar:hasOutputSection marriage:SectionVerdict, marriage:SectionFoundation, marriage:SectionMechanism, marriage:SectionGuidance .
marriage:ContractHandoff a ar:AnswerContract ; ar:stableId "marriage.contract.handoff" ; skos:prefLabel "Compatibility handoff"@en ; ar:hasOutputSection marriage:SectionVerdict, marriage:SectionClarification .
marriage:ContractRemedy a ar:AnswerContract ; ar:stableId "marriage.contract.remedy" ; skos:prefLabel "Calculated marriage remedy answer"@en ; ar:hasOutputSection marriage:SectionVerdict, marriage:SectionMechanism, marriage:SectionGuidance, marriage:SectionClarification .
marriage:ContractComparison a ar:AnswerContract ; ar:stableId "marriage.contract.comparison" ; skos:prefLabel "Marriage pathway comparison"@en ; ar:hasOutputSection marriage:SectionVerdict, marriage:SectionFoundation, marriage:SectionMechanism, marriage:SectionGuidance, marriage:SectionClarification .
marriage:ContractMuhurat a ar:AnswerContract ; ar:stableId "marriage.contract.muhurat" ; skos:prefLabel "Marriage Muhurat selection"@en ; ar:hasOutputSection marriage:SectionVerdict, marriage:SectionTiming, marriage:SectionGuidance, marriage:SectionClarification .
marriage:ContractCompatibility a ar:AnswerContract ; ar:stableId "marriage.contract.compatibility" ; skos:prefLabel "Two-chart compatibility analysis"@en ; ar:hasOutputSection marriage:SectionVerdict, marriage:SectionFoundation, marriage:SectionMechanism, marriage:SectionGuidance .

# Evidence policies, rules and guardrails.
marriage:EvidencePromise a ar:EvidencePolicy ; ar:stableId "marriage.evidence.promise" ; ar:ruleText "Judge D1 seventh-house and lord promise first; use D9 only as confirmation. Houses 2 or 8 alone cannot establish marriage promise." .
marriage:EvidenceOutlook a ar:EvidencePolicy ; ar:stableId "marriage.evidence.outlook" ; ar:ruleText "Describe the asked relationship using D1 foundation, D9 confirmation, support and friction; do not add dates unless requested." .
marriage:EvidenceTiming a ar:EvidencePolicy ; ar:stableId "marriage.evidence.timing" ; ar:ruleText "A dated event needs natal promise, matching dasha permission and transit delivery; activation alone is not the event." .
marriage:EvidenceHistoricalMarriage a ar:EvidencePolicy ; ar:stableId "marriage.evidence.history" ; ar:ruleText "Scan past adult life only. Rank periods where the D1 and D9 marriage foundation, H2-H7-H11 dasha carriers, and historical transit reinforcement converge. Return probable periods for user confirmation, never a claimed factual marriage date." .
marriage:EvidenceSeparation a ar:EvidencePolicy ; ar:stableId "marriage.evidence.separation" ; ar:ruleText "Distinguish conflict, distance, separation and legal divorce; evaluate both separation pressure and reconciliation support without certainty." .
marriage:EvidenceProfile a ar:EvidencePolicy ; ar:stableId "marriage.evidence.profile" ; ar:ruleText "Describe spouse temperament by synthesizing the seventh house/lord, seventh-lord nakshatra, Darakaraka, Venus rashi/nakshatra and D9; disclose that all indications come from the native chart." .
marriage:EvidenceAppearance a ar:EvidencePolicy ; ar:stableId "marriage.evidence.appearance" ; ar:ruleText "Describe only probable physical build, visible expression and visual style by converging seventh-house rashi, seventh lord, Darakaraka, Venus and D9; never replace appearance with personality or claim photographic certainty." .
marriage:EvidenceSpouseLocation a ar:EvidencePolicy ; ar:stableId "marriage.evidence.spouse_location" ; ar:ruleText "A different-city, culture or background claim requires a direct spouse-indicator link to houses 3, 9 or 12 or explicit Rahu linkage; house 4 supports local roots, while sign modality alone is insufficient." .
marriage:EvidenceCompatibility a ar:EvidencePolicy ; ar:stableId "marriage.evidence.compatibility" ; ar:ruleText "Compatibility requires two resolved birth charts and belongs to the dedicated Partnership flow." .
marriage:EvidenceRemedy a ar:EvidencePolicy ; ar:stableId "marriage.evidence.remedy" ; ar:ruleText "Use only the calculated marriage-focused remedy blueprint and its ranked actions; a top-remedy selection asks for exactly one action, while a broad plan asks for three, each with frequency and chart rationale." .
marriage:EvidenceChoice a ar:EvidencePolicy ; ar:stableId "marriage.evidence.choice" ; ar:ruleText "Compare love-led and family-mediated pathways independently through romance, commitment, family continuity and social-framework evidence; do not force a binary certainty." .
marriage:EvidenceRemarriage a ar:EvidencePolicy ; ar:stableId "marriage.evidence.remarriage" ; ar:ruleText "Require verified prior-marriage context, then assess renewed partnership promise and only then calculate remarriage timing." .
marriage:EvidenceMilestones a ar:EvidencePolicy ; ar:stableId "marriage.evidence.milestones" ; ar:ruleText "Treat engagement and wedding as distinct events with separately labelled windows; never attach one event's peak to the other." .
marriage:EvidenceMeeting a ar:EvidencePolicy ; ar:stableId "marriage.evidence.meeting" ; ar:ruleText "Describe probable environments and channels of meeting from the derived spouse frame; do not identify a person, exact place or date." .
marriage:EvidenceSpouseDetails a ar:EvidencePolicy ; ar:stableId "marriage.evidence.spouse_details" ; ar:ruleText "Separate profession/status, location/settlement and appearance/style indications, and disclose that all are derived from the native's chart." .
marriage:EvidenceAffair a ar:EvidencePolicy ; ar:stableId "marriage.evidence.affair" ; ar:ruleText "Assess attraction, secrecy, conflict and continuity as alternative pressures; astrology cannot establish an affair or identify a third party." .
marriage:EvidenceMuhurat a ar:EvidencePolicy ; ar:stableId "marriage.evidence.muhurat" ; ar:ruleText "Use the dedicated Vivah Muhurat calculator only after event, date range and location/timezone are resolved; do not substitute natal event timing." .

marriage:NoUnrequestedTiming a ar:Guardrail ; ar:stableId "marriage.guard.no_timing" ; ar:ruleText "Static promise, outlook, diagnosis and profile questions exclude dasha, transit and calendar windows." .
marriage:NatalPromiseFirst a ar:Guardrail ; ar:stableId "marriage.guard.promise_first" ; ar:ruleText "Never infer marriage or separation from current activation without the matching natal foundation." .
marriage:NoActivationCertainty a ar:Guardrail ; ar:stableId "marriage.guard.activation" ; ar:ruleText "Activation may mean attention, pressure or negotiation and does not prove marriage, separation or reunion." .
marriage:NoDivorceCertainty a ar:Guardrail ; ar:stableId "marriage.guard.divorce" ; ar:ruleText "Never declare divorce, betrayal, abuse or permanent separation as certain from astrology." .
marriage:ClarifyRelationshipStatus a ar:Guardrail ; ar:stableId "marriage.guard.status" ; ar:ruleText "Separation, reconciliation and return questions require the current relationship status and named subject." .
marriage:DerivedChartDisclosure a ar:Guardrail ; ar:stableId "marriage.guard.derived" ; ar:ruleText "Call spouse evidence indications from the native's chart; never present it as the spouse's own chart or dasha." .
marriage:TwoChartsRequired a ar:Guardrail ; ar:stableId "marriage.guard.two_charts" ; ar:ruleText "Do not perform compatibility from one chart; hand off until both chart identities are resolved." .
marriage:StrictRequestedHorizon a ar:Guardrail ; ar:stableId "marriage.guard.horizon" ; ar:ruleText "Do not mention dates outside the user's requested horizon." .
marriage:RetrospectiveProbabilityOnly a ar:Guardrail ; ar:stableId "marriage.guard.retrospective_probability" ; ar:ruleText "A past activation window is only a probable marriage-capable period. Never say this is when the user actually married without confirmation." .
marriage:HistoricalScopeOnly a ar:Guardrail ; ar:stableId "marriage.guard.historical_scope" ; ar:ruleText "Use only periods after the historical scan's minimum age and on or before its as-of date; never add a future window." .
marriage:CalculatedRemediesOnly a ar:Guardrail ; ar:stableId "marriage.guard.calculated_remedies" ; ar:ruleText "Never improvise generic remedies or claim a remedy guarantees marriage, fidelity or reconciliation." .
marriage:NoBinaryMarriageTypeCertainty a ar:Guardrail ; ar:stableId "marriage.guard.marriage_type" ; ar:ruleText "Do not declare love or arranged marriage as certain; explain relative pathway support and mixed outcomes." .
marriage:PriorMarriageRequired a ar:Guardrail ; ar:stableId "marriage.guard.prior_marriage" ; ar:ruleText "Do not interpret remarriage until the prior marriage or legal partnership context is confirmed." .
marriage:SeparateMilestones a ar:Guardrail ; ar:stableId "marriage.guard.milestones" ; ar:ruleText "Do not merge engagement, registration, ceremony and cohabitation into one event without clarification." .
marriage:MeetingContextNotIdentity a ar:Guardrail ; ar:stableId "marriage.guard.meeting" ; ar:ruleText "Do not claim an exact person, venue, city, date or guaranteed meeting circumstance from one chart." .
marriage:SpouseDetailScope a ar:Guardrail ; ar:stableId "marriage.guard.spouse_details" ; ar:ruleText "Keep profession, location and appearance as separate probabilistic indication groups from the native's chart." .
marriage:NoAffairAssertion a ar:Guardrail ; ar:stableId "marriage.guard.affair" ; ar:ruleText "Never state that a spouse is cheating, identify a third party or advise confrontation from astrology alone." .
marriage:MuhuratInputsRequired a ar:Guardrail ; ar:stableId "marriage.guard.muhurat_inputs" ; ar:ruleText "Require the marriage event, usable date range and verified location/timezone before calculating Muhurat." .
marriage:MuhuratNotEventPrediction a ar:Guardrail ; ar:stableId "marriage.guard.muhurat_not_prediction" ; ar:ruleText "A favorable Muhurat selects a ceremony time; it does not predict when marriage will happen." .

marriage:RulePromiseThenTiming a ar:DecisionRule ; ar:stableId "marriage.rule.promise_timing" ; ar:ruleText "Evaluate natal promise, then dasha permission, then transit delivery in that order." .
marriage:RuleD9Confirms a ar:DecisionRule ; ar:stableId "marriage.rule.d9" ; ar:ruleText "D9 confirms and refines the D1 marriage foundation but does not create a missing D1 promise." .
marriage:RuleRankHistoricalConvergence a ar:DecisionRule ; ar:stableId "marriage.rule.history" ; ar:ruleText "Rank past periods by marriage-house dasha activation first and historical transit reinforcement second; return up to three materially distinct periods in descending probability." .
marriage:RuleSeparateOutcomes a ar:DecisionRule ; ar:stableId "marriage.rule.separation" ; ar:ruleText "Score relationship strain, physical distance, separation, legal dissolution and reconciliation as distinct outcomes." .
marriage:RuleCompareMarriagePathways a ar:DecisionRule ; ar:stableId "marriage.rule.pathways" ; ar:ruleText "Score love-led and family-mediated pathways separately before giving a relative or mixed verdict." .
marriage:RuleRemarriageContextFirst a ar:DecisionRule ; ar:stableId "marriage.rule.remarriage" ; ar:ruleText "Resolve the prior relationship outcome before judging a new formal union and its timing." .
marriage:RuleSeparateMarriageMilestones a ar:DecisionRule ; ar:stableId "marriage.rule.milestones" ; ar:ruleText "Generate separately owned evidence and windows for engagement and wedding." .
marriage:RuleDerivedSpouseScopes a ar:DecisionRule ; ar:stableId "marriage.rule.spouse_scopes" ; ar:ruleText "Evaluate meeting channel, profession, settlement and appearance through their own derived-house scopes." .
marriage:RuleSynthesizeSpouseTemperament a ar:DecisionRule ; ar:stableId "marriage.rule.spouse_temperament" ; ar:ruleText "Synthesize all five spouse-temperament layers and let D9 confirm or qualify D1; no single house, planet, rashi or nakshatra may become the whole personality." .
marriage:RuleSynthesizeSpouseAppearance a ar:DecisionRule ; ar:stableId "marriage.rule.spouse_appearance" ; ar:ruleText "Synthesize build, face/expression and visual style only where the five appearance layers converge; express conflicts as ranges and exclude temperament, exact measurements and protected physical identity claims." .
marriage:RuleCompareSpouseLocationSignals a ar:DecisionRule ; ar:stableId "marriage.rule.spouse_location" ; ar:ruleText "Compare direct distance and local-root signals; do not infer foreignness from Saturn, Virgo, a nakshatra, ordinary conjunctions or timing activation." .
marriage:RuleAffairAlternatives a ar:DecisionRule ; ar:stableId "marriage.rule.affair" ; ar:ruleText "Distinguish attraction, secrecy, emotional distance, ordinary conflict and actual third-party evidence; never collapse them into betrayal." .
marriage:RuleCalculatedMarriageRemedies a ar:DecisionRule ; ar:stableId "marriage.rule.remedies" ; ar:ruleText "For which/best/most-relevant remedy questions, return exactly the blueprint's top recommendation; otherwise return its top three. Always state action, frequency and chart reason without repeating diagnosis or timing." .
marriage:RuleMarriageMuhuratInputs a ar:DecisionRule ; ar:stableId "marriage.rule.muhurat" ; ar:ruleText "Resolve event, date range and location/timezone, then rank only calculator-returned Vivah Muhurat slots." .

# Decision stages with expandable factor children.
marriage:PromiseStage a ar:DecisionStage ; ar:sequence 1 ; skos:prefLabel "Natal partnership promise"@en ; ar:stageRequiresFactor marriage:D1, marriage:H7, marriage:SeventhLord, marriage:VenusJupiter .
marriage:ContinuityStage a ar:DecisionStage ; ar:sequence 2 ; skos:prefLabel "Family continuity and fulfilment"@en ; ar:stageRequiresFactor marriage:H2, marriage:H7, marriage:H11 .
marriage:RomanceStage a ar:DecisionStage ; ar:sequence 2 ; skos:prefLabel "Romance, affection and commitment"@en ; ar:stageRequiresFactor marriage:H5, marriage:H7, marriage:H11, marriage:VenusJupiter .
marriage:D9Stage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "D9 confirmation"@en ; ar:stageRequiresFactor marriage:D9, marriage:VenusJupiter .
marriage:AdvancedStage a ar:DecisionStage ; ar:sequence 4 ; skos:prefLabel "KP and Jaimini confirmation"@en ; ar:stageRequiresFactor marriage:KpSeventh, marriage:DarakarakaUpapada .
marriage:StrainStage a ar:DecisionStage ; ar:sequence 4 ; skos:prefLabel "Conflict, intimacy and withdrawal pressure"@en ; ar:stageRequiresFactor marriage:H7, marriage:H8, marriage:H12, marriage:RelationshipContext .
marriage:SpouseProfileStage a ar:DecisionStage ; ar:sequence 2 ; skos:prefLabel "Five-layer spouse temperament synthesis"@en ; ar:stageRequiresFactor marriage:DerivedSpouseFrame, marriage:H7, marriage:SeventhLord, marriage:SeventhLordNakshatra, marriage:Darakaraka, marriage:VenusRashiNakshatra, marriage:D9 .
marriage:SpouseAppearanceStage a ar:DecisionStage ; ar:sequence 2 ; skos:prefLabel "Five-layer spouse appearance synthesis"@en ; ar:stageRequiresFactor marriage:DerivedSpouseFrame, marriage:H7, marriage:SeventhLord, marriage:SeventhLordNakshatra, marriage:Darakaraka, marriage:VenusRashiNakshatra, marriage:D9 .
marriage:SpouseLocationStage a ar:DecisionStage ; ar:sequence 2 ; skos:prefLabel "Spouse local-versus-distance background comparison"@en ; ar:stageRequiresFactor marriage:DerivedSpouseFrame, marriage:H3, marriage:H4, marriage:H7, marriage:H9, marriage:H12, marriage:SeventhLord, marriage:Darakaraka, marriage:D9 .
marriage:DashaStage a ar:DecisionStage ; ar:sequence 8 ; skos:prefLabel "Dasha permission"@en ; ar:stageRequiresFactor marriage:DashaActivation .
marriage:TransitStage a ar:DecisionStage ; ar:sequence 9 ; skos:prefLabel "Dated transit delivery"@en ; ar:stageRequiresFactor marriage:TransitConfirmation .
marriage:CompatibilityStage a ar:DecisionStage ; ar:sequence 1 ; skos:prefLabel "Resolve both charts"@en ; ar:stageRequiresFactor marriage:D1, marriage:SecondChart .
marriage:RemedyStage a ar:DecisionStage ; ar:sequence 5 ; skos:prefLabel "Calculated marriage remedy plan"@en ; ar:stageRequiresFactor marriage:D1, marriage:D9, marriage:RemedyBlueprint .
marriage:MarriageChoiceStage a ar:DecisionStage ; ar:sequence 4 ; skos:prefLabel "Love-led versus family-mediated pathway"@en ; ar:stageRequiresFactor marriage:H2, marriage:H5, marriage:H7, marriage:H9, marriage:H11, marriage:D9 .
marriage:RemarriageStage a ar:DecisionStage ; ar:sequence 4 ; skos:prefLabel "Prior union and renewed partnership promise"@en ; ar:stageRequiresFactor marriage:PriorMarriageContext, marriage:H2, marriage:H7, marriage:H8, marriage:H9, marriage:H11, marriage:H12, marriage:D9 .
marriage:MilestoneStage a ar:DecisionStage ; ar:sequence 5 ; skos:prefLabel "Engagement and wedding as separate milestones"@en ; ar:stageRequiresFactor marriage:H2, marriage:H5, marriage:H7, marriage:H9, marriage:H11 .
marriage:MeetingStage a ar:DecisionStage ; ar:sequence 4 ; skos:prefLabel "Probable spouse meeting channels"@en ; ar:stageRequiresFactor marriage:DerivedSpouseFrame, marriage:SeventhLord, marriage:H3, marriage:H7, marriage:H9, marriage:H11, marriage:H12 .
marriage:SpouseDetailsStage a ar:DecisionStage ; ar:sequence 4 ; skos:prefLabel "Spouse profession, location and appearance scopes"@en ; ar:stageRequiresFactor marriage:DerivedSpouseFrame, marriage:H4, marriage:H7, marriage:H9, marriage:H10, marriage:H12, marriage:D9 .
marriage:AffairStage a ar:DecisionStage ; ar:sequence 4 ; skos:prefLabel "Attraction, secrecy, conflict and continuity alternatives"@en ; ar:stageRequiresFactor marriage:H5, marriage:H6, marriage:H7, marriage:H8, marriage:H12, marriage:RelationshipContext .
marriage:MuhuratStage a ar:DecisionStage ; ar:sequence 1 ; skos:prefLabel "Resolve Vivah Muhurat inputs"@en ; ar:stageRequiresFactor marriage:MuhuratInputs .

