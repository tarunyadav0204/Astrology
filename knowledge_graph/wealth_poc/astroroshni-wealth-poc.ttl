@prefix ar: <https://astroroshni.com/ontology/core#> .
@prefix wealth: <https://astroroshni.com/ontology/wealth#> .
@prefix domain: <https://astroroshni.com/ontology/domain#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wealth:Ontology a owl:Ontology ; rdfs:label "AstroRoshni Instant Wealth and Finance ontology"@en ; owl:versionInfo "0.2.0" .

ar:LifeDomain a owl:Class ; rdfs:label "Life domain"@en .
ar:QuestionType a owl:Class ; rdfs:label "Question type"@en .
ar:AstrologyFactor a owl:Class ; rdfs:label "Astrology factor"@en .
ar:CalculatorCapability a owl:Class ; rdfs:label "Calculator capability"@en .
ar:AnswerMode a owl:Class ; rdfs:label "Answer mode"@en .
ar:AnswerContract a owl:Class ; rdfs:label "Answer contract"@en .
ar:EvidencePolicy a owl:Class ; rdfs:label "Evidence policy"@en .
ar:Guardrail a owl:Class ; rdfs:label "Guardrail"@en .
ar:DecisionRule a owl:Class ; rdfs:label "Decision rule"@en .
ar:DecisionStage a owl:Class ; rdfs:label "Decision stage"@en .
ar:OutputSection a owl:Class ; rdfs:label "Output section"@en .
ar:inDomain a owl:ObjectProperty ; rdfs:label "Life domain"@en .
ar:requiresFactor a owl:ObjectProperty ; rdfs:label "Required astrology factors"@en .
ar:defaultExcludesFactor a owl:ObjectProperty ; rdfs:label "Excluded by default"@en .
ar:requiresCapability a owl:ObjectProperty ; rdfs:label "Required calculator capabilities"@en .
ar:allowedAnswerMode a owl:ObjectProperty ; rdfs:label "Answer mode"@en .
ar:usesAnswerContract a owl:ObjectProperty ; rdfs:label "Answer contract"@en .
ar:hasEvidencePolicy a owl:ObjectProperty ; rdfs:label "Evidence policy"@en .
ar:hasGuardrail a owl:ObjectProperty ; rdfs:label "Guardrails"@en .
ar:evaluatesRule a owl:ObjectProperty ; rdfs:label "Decision rules"@en .
ar:evaluatesStage a owl:ObjectProperty ; rdfs:label "Decision stages"@en .
ar:stageRequiresFactor a owl:ObjectProperty ; rdfs:label "Required astrology factors"@en .
ar:hasOutputSection a owl:ObjectProperty ; rdfs:label "Output sections"@en .
ar:stableId a owl:DatatypeProperty ; rdfs:label "Stable identifier"@en .
ar:runtimeKey a owl:DatatypeProperty ; rdfs:label "Runtime key"@en .
ar:calculatorBinding a owl:DatatypeProperty ; rdfs:label "Calculator binding"@en .
ar:questionExample a owl:DatatypeProperty ; rdfs:label "Question example"@en .
ar:ruleText a owl:DatatypeProperty ; rdfs:label "Rule text"@en .
ar:sequence a owl:DatatypeProperty ; rdfs:label "Sequence"@en .
ar:overrideCondition a owl:DatatypeProperty ; rdfs:label "Override condition"@en .

wealth:Wealth a ar:LifeDomain ; ar:stableId "wealth.domain.legacy_alias" ; skos:prefLabel "Wealth and finance"@en ; owl:sameAs domain:WealthFinance .

# Evidence factors.
wealth:D1 a ar:AstrologyFactor ; skos:prefLabel "D1 financial promise"@en .
wealth:D2 a ar:AstrologyFactor ; skos:prefLabel "D2 Hora manifestation and retention"@en .
wealth:D4 a ar:AstrologyFactor ; skos:prefLabel "D4 fixed-asset confirmation when relevant"@en .
wealth:D5 a ar:AstrologyFactor ; skos:prefLabel "D5 optional investment-intelligence confirmation"@en .
wealth:D8 a ar:AstrologyFactor ; skos:prefLabel "D8 optional inheritance and settlement confirmation"@en .
wealth:D9 a ar:AstrologyFactor ; skos:prefLabel "D9 supporting maturity and underlying carrier condition"@en .
wealth:D10 a ar:AstrologyFactor ; skos:prefLabel "D10 profession-to-income conversion"@en .
wealth:D11 a ar:AstrologyFactor ; skos:prefLabel "D11 optional gains confirmation"@en .
wealth:H1 a ar:AstrologyFactor ; skos:prefLabel "House 1 · personal capacity"@en .
wealth:H2 a ar:AstrologyFactor ; skos:prefLabel "House 2 · accumulation, savings and reserves"@en .
wealth:H4 a ar:AstrologyFactor ; skos:prefLabel "House 4 · fixed assets"@en .
wealth:H5 a ar:AstrologyFactor ; skos:prefLabel "House 5 · judgment and calculated risk"@en .
wealth:H6 a ar:AstrologyFactor ; skos:prefLabel "House 6 · service income, debt and obligations"@en .
wealth:H7 a ar:AstrologyFactor ; skos:prefLabel "House 7 · trade, clients and shared contracts"@en .
wealth:H8 a ar:AstrologyFactor ; skos:prefLabel "House 8 · joint money, liabilities, inheritance and settlement"@en .
wealth:H9 a ar:AstrologyFactor ; skos:prefLabel "House 9 · fortune and long-range support"@en .
wealth:H10 a ar:AstrologyFactor ; skos:prefLabel "House 10 · earning engine through work"@en .
wealth:H11 a ar:AstrologyFactor ; skos:prefLabel "House 11 · gains and realization"@en .
wealth:H12 a ar:AstrologyFactor ; skos:prefLabel "House 12 · expenditure, deployment and leakage"@en .
wealth:LordNakshatraChain a ar:AstrologyFactor ; skos:prefLabel "Relevant house lords, placements, nakshatras and dispositors"@en .
wealth:DignityStrength a ar:AstrologyFactor ; skos:prefLabel "Dignity, functional nature and Shadbala"@en .
wealth:DhanaYogas a ar:AstrologyFactor ; skos:prefLabel "Calculated and operational Dhana combinations"@en .
wealth:InduLagna a ar:AstrologyFactor ; skos:prefLabel "Indu Lagna, its lord, occupants, aspects and 2nd/11th"@en .
wealth:HoraLagna a ar:AstrologyFactor ; skos:prefLabel "Hora Lagna material capacity"@en .
wealth:ArudhaGains a ar:AstrologyFactor ; skos:prefLabel "Arudha Lagna and 2nd/11th from AL"@en .
wealth:KPFructification a ar:AstrologyFactor ; skos:prefLabel "Route-specific KP cusp significators and sub-lords"@en .
wealth:DashaActivation a ar:AstrologyFactor ; skos:prefLabel "Dasha permission for the same financial result"@en .
wealth:TransitConfirmation a ar:AstrologyFactor ; skos:prefLabel "Dated transit confirmation inside the permitted dasha"@en .
wealth:RemedyBlueprint a ar:AstrologyFactor ; skos:prefLabel "Calculated financial remedy blueprint"@en .

# Executable capabilities.
wealth:CapNatalFoundation a ar:CalculatorCapability ; ar:stableId "wealth.cap.natal" ; ar:calculatorBinding "WealthCalculator and natal_promise: D1 route-specific financial promise" ; skos:prefLabel "Calculate natal financial promise"@en .
wealth:CapD2 a ar:CalculatorCapability ; ar:stableId "wealth.cap.d2" ; ar:calculatorBinding "DivisionalChartCalculator: D2 Hora" ; skos:prefLabel "Calculate D2 manifestation and retention"@en .
wealth:CapLordChain a ar:CalculatorCapability ; ar:stableId "wealth.cap.lords" ; ar:calculatorBinding "HouseAnalyzer, PlanetAnalyzer and nakshatra context" ; skos:prefLabel "Calculate lord and nakshatra chains"@en .
wealth:CapStrength a ar:CalculatorCapability ; ar:stableId "wealth.cap.strength" ; ar:calculatorBinding "PlanetaryDignitiesCalculator and classical Shadbala" ; skos:prefLabel "Calculate financial carrier strength"@en .
wealth:CapYogas a ar:CalculatorCapability ; ar:stableId "wealth.cap.yogas" ; ar:calculatorBinding "YogaCalculator and natal_promise planetary connections" ; skos:prefLabel "Calculate Dhana combinations"@en .
wealth:CapIndu a ar:CalculatorCapability ; ar:stableId "wealth.cap.indu" ; ar:calculatorBinding "InduLagnaCalculator.get_indu_lagna_analysis" ; skos:prefLabel "Calculate complete Indu Lagna evidence"@en .
wealth:CapSpecialLagnas a ar:CalculatorCapability ; ar:stableId "wealth.cap.special_lagnas" ; ar:calculatorBinding "JaiminiPointCalculator: Hora Lagna and Arudha Lagna" ; skos:prefLabel "Calculate Hora and Arudha manifestation"@en .
wealth:CapKP a ar:CalculatorCapability ; ar:stableId "wealth.cap.kp" ; ar:calculatorBinding "KP cusp chain and fructification calculator" ; skos:prefLabel "Calculate route-specific KP materialization"@en .
wealth:CapDivisionals a ar:CalculatorCapability ; ar:stableId "wealth.cap.optional_divisions" ; ar:calculatorBinding "DivisionalChartCalculator: optional D4, D5, D8, D9, D10 and D11" ; skos:prefLabel "Calculate route-specific divisional confirmation"@en .
wealth:CapDasha a ar:CalculatorCapability ; ar:stableId "wealth.cap.dasha" ; ar:calculatorBinding "instant event horizon: wealth-result dasha activation" ; skos:prefLabel "Calculate financial dasha permission"@en .
wealth:CapTransit a ar:CalculatorCapability ; ar:stableId "wealth.cap.transit" ; ar:calculatorBinding "instant transit activation timeline with Instant aspect policy" ; skos:prefLabel "Calculate dated transit confirmation"@en .
wealth:CapRemedy a ar:CalculatorCapability ; ar:stableId "wealth.cap.remedy" ; ar:calculatorBinding "RemedyEngine calculated priority blueprint" ; skos:prefLabel "Calculate financial remedy"@en .

wealth:ModeTopic a ar:AnswerMode ; ar:runtimeKey "topic_reading" ; skos:prefLabel "Static financial reading"@en .
wealth:ModeCapacity a ar:AnswerMode ; ar:runtimeKey "potential_capacity" ; skos:prefLabel "Financial capacity or suitability"@en .
wealth:ModeDiagnosis a ar:AnswerMode ; ar:runtimeKey "problem_diagnosis" ; skos:prefLabel "Financial problem diagnosis"@en .
wealth:ModeTiming a ar:AnswerMode ; ar:runtimeKey "timing_window" ; skos:prefLabel "Financial timing forecast"@en .
wealth:ModeDecision a ar:AnswerMode ; ar:runtimeKey "decision_support" ; skos:prefLabel "Financial decision support"@en .
wealth:ModeComparison a ar:AnswerMode ; ar:runtimeKey "comparison_choice" ; skos:prefLabel "Financial option comparison"@en .
wealth:ModeRemedy a ar:AnswerMode ; ar:runtimeKey "remedy_action" ; skos:prefLabel "Calculated financial remedy"@en .

wealth:SectionVerdict a ar:OutputSection ; skos:prefLabel "Direct financial verdict"@en .
wealth:SectionPromise a ar:OutputSection ; skos:prefLabel "D1 and D2 foundation"@en .
wealth:SectionMechanism a ar:OutputSection ; skos:prefLabel "Financial mechanism"@en .
wealth:SectionManifestation a ar:OutputSection ; skos:prefLabel "Indu, Hora and Arudha manifestation"@en .
wealth:SectionRisk a ar:OutputSection ; skos:prefLabel "Risk and retention"@en .
wealth:SectionTiming a ar:OutputSection ; skos:prefLabel "Dasha and transit window"@en .
wealth:SectionGuidance a ar:OutputSection ; skos:prefLabel "Practical educational guidance"@en .
wealth:ContractStatic a ar:AnswerContract ; ar:stableId "wealth.contract.static" ; skos:prefLabel "Static Wealth answer"@en ; ar:hasOutputSection wealth:SectionVerdict, wealth:SectionPromise, wealth:SectionMechanism, wealth:SectionManifestation, wealth:SectionRisk, wealth:SectionGuidance .
wealth:ContractTimed a ar:AnswerContract ; ar:stableId "wealth.contract.timed" ; skos:prefLabel "Timed Wealth answer"@en ; ar:hasOutputSection wealth:SectionVerdict, wealth:SectionPromise, wealth:SectionMechanism, wealth:SectionRisk, wealth:SectionTiming, wealth:SectionGuidance .
wealth:ContractRemedy a ar:AnswerContract ; ar:stableId "wealth.contract.remedy" ; skos:prefLabel "Calculated Wealth remedy answer"@en ; ar:hasOutputSection wealth:SectionVerdict, wealth:SectionMechanism, wealth:SectionGuidance .

wealth:EvidenceStatic a ar:EvidencePolicy ; ar:stableId "wealth.evidence.static" ; ar:ruleText "D1 establishes promise, D2 confirms manifestation and retention, and special lagnas only modify the supported conclusion." .
wealth:EvidenceTimed a ar:EvidencePolicy ; ar:stableId "wealth.evidence.timed" ; ar:ruleText "A dated financial result requires natal promise, matching dasha permission and transit confirmation of the same route-specific houses." .
wealth:EvidenceInvestment a ar:EvidencePolicy ; ar:stableId "wealth.evidence.investment" ; ar:ruleText "Assess judgment, retention and loss exposure from D1, D2 and D5; use D9 only to qualify the maturity and sustainable expression of the relevant carriers. Never recommend securities, trades or guaranteed returns." .
wealth:EvidenceInheritance a ar:EvidencePolicy ; ar:stableId "wealth.evidence.inheritance" ; ar:ruleText "Assess receipt or settlement potential without predicting another person's death." .
wealth:EvidenceRemedy a ar:EvidencePolicy ; ar:stableId "wealth.evidence.remedy" ; ar:ruleText "Use only a calculated remedy blueprint linked to the dominant financial mechanism." .

wealth:NoUnrequestedTiming a ar:Guardrail ; ar:stableId "wealth.guard.no_timing" ; ar:ruleText "Static financial questions exclude dasha, transit and calendar windows." .
wealth:D1D2Required a ar:Guardrail ; ar:stableId "wealth.guard.d1_d2" ; ar:ruleText "Special lagnas and named yogas cannot replace D1 and D2 synthesis." .
wealth:InduNoOverride a ar:Guardrail ; ar:stableId "wealth.guard.indu" ; ar:ruleText "Indu Lagna supports manifestation but cannot independently create or time wealth." .
wealth:NoActivationPolarity a ar:Guardrail ; ar:stableId "wealth.guard.activation" ; ar:ruleText "House activation is not automatically a gain; classify income, retention, debt, liability, expense or volatility." .
wealth:NoNodeFifthNinth a ar:Guardrail ; ar:stableId "wealth.guard.nodes" ; ar:ruleText "Rahu and Ketu never use fifth or ninth aspects; retain occupation, conjunction and seventh aspect only." .
wealth:NoGuaranteedReturn a ar:Guardrail ; ar:stableId "wealth.guard.returns" ; ar:ruleText "Never guarantee profit, repayment, approval, inheritance, windfall or financial outcome." .
wealth:NoSecurityRecommendation a ar:Guardrail ; ar:stableId "wealth.guard.securities" ; ar:ruleText "Never prescribe a stock, security, trade, leverage level or transaction." .
wealth:NoDeathPrediction a ar:Guardrail ; ar:stableId "wealth.guard.death" ; ar:ruleText "Inheritance analysis never predicts a person's death or death date." .
wealth:NoWindfallCertainty a ar:Guardrail ; ar:stableId "wealth.guard.windfall" ; ar:ruleText "Never claim lottery or sudden wealth certainty from the fifth, eighth, Rahu or a yoga." .
wealth:NoPropertyDrift a ar:Guardrail ; ar:stableId "wealth.guard.property" ; ar:ruleText "Asset capacity may be discussed, but a property event belongs to the Property domain." .
wealth:NoCareerDrift a ar:Guardrail ; ar:stableId "wealth.guard.career" ; ar:ruleText "D10 explains profession-to-income conversion but does not replace a Career answer." .
wealth:NoGenericRemedy a ar:Guardrail ; ar:stableId "wealth.guard.remedy" ; ar:ruleText "Do not invent or substitute a generic remedy when the calculated blueprint is absent." .
wealth:NoSinglePlacementVerdict a ar:Guardrail ; ar:stableId "wealth.guard.single_placement" ; ar:ruleText "Never judge investment or speculation from the fifth lord's destination alone; include its dignity, strength, Gandanta, Avayogi, Dagdha and Tithi-Shunya roles, conjunctions, declared overlap rules, D5 and supporting D9 condition." .
wealth:StrictHorizon a ar:Guardrail ; ar:stableId "wealth.guard.horizon" ; ar:ruleText "Do not mention dates outside the user's requested horizon." .

wealth:RulePromiseFirst a ar:DecisionRule ; ar:stableId "wealth.rule.promise" ; ar:ruleText "D1 establishes route-specific promise before D2 and special-lagna confirmation." .
wealth:RuleRetentionVsGain a ar:DecisionRule ; ar:stableId "wealth.rule.retention" ; ar:ruleText "House 11 shows realization while house 2 and D2 determine whether gains accumulate and remain." .
wealth:RuleRouteSpecific a ar:DecisionRule ; ar:stableId "wealth.rule.route" ; ar:ruleText "Use different house and KP chains for income, debt, investment and inheritance." .
wealth:RuleYogaOperational a ar:DecisionRule ; ar:stableId "wealth.rule.yoga" ; ar:ruleText "A Dhana Yoga matters only when exact, sufficiently strong and operational through the relevant dasha." .
wealth:RuleTimedChain a ar:DecisionRule ; ar:stableId "wealth.rule.timing" ; ar:ruleText "Timing requires natal promise, matching MD-AD permission, optional PD narrowing and transit confirmation." .
wealth:RuleCarrierCondition a ar:DecisionRule ; ar:stableId "wealth.rule.carrier_condition" ; ar:ruleText "A relevant house lord or financial significator is judged as one combined carrier: placement plus dignity, Shadbala, Gandanta, special lordships, conjunctions and divisional condition; a favorable destination cannot erase supplied afflictions or overrides." .

# Expandable decision stages.
wealth:NatalStage a ar:DecisionStage ; ar:sequence 1 ; skos:prefLabel "Natal financial promise"@en ; ar:stageRequiresFactor wealth:D1, wealth:H2, wealth:H11, wealth:LordNakshatraChain, wealth:DignityStrength, wealth:DhanaYogas .
wealth:ManifestationStage a ar:DecisionStage ; ar:sequence 2 ; skos:prefLabel "Manifestation and retention"@en ; ar:stageRequiresFactor wealth:D2, wealth:InduLagna, wealth:HoraLagna, wealth:ArudhaGains .
wealth:SourceStage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "Income source and earning structure"@en ; ar:stageRequiresFactor wealth:H2, wealth:H6, wealth:H7, wealth:H10, wealth:H11, wealth:D10 .
wealth:RiskStage a ar:DecisionStage ; ar:sequence 4 ; skos:prefLabel "Retention, liability and leakage"@en ; ar:stageRequiresFactor wealth:H2, wealth:H6, wealth:H8, wealth:H12 .
wealth:IncomeStage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "Income stability and realization"@en ; ar:stageRequiresFactor wealth:H2, wealth:H6, wealth:H10, wealth:H11, wealth:D10, wealth:KPFructification .
wealth:DebtStage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "Debt, obligations and repayment capacity"@en ; ar:stageRequiresFactor wealth:H2, wealth:H6, wealth:H8, wealth:H11, wealth:H12, wealth:KPFructification .
wealth:InvestmentStage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "Investment judgment and realization"@en ; ar:stageRequiresFactor wealth:H2, wealth:H5, wealth:H8, wealth:H11, wealth:H12, wealth:D5, wealth:D9, wealth:KPFructification .
wealth:InheritanceStage a ar:DecisionStage ; ar:sequence 3 ; skos:prefLabel "Inheritance and settlement realization"@en ; ar:stageRequiresFactor wealth:H2, wealth:H8, wealth:H9, wealth:H11, wealth:D8, wealth:KPFructification .
wealth:DashaStage a ar:DecisionStage ; ar:sequence 8 ; skos:prefLabel "Dasha permission"@en ; ar:stageRequiresFactor wealth:DashaActivation .
wealth:TransitStage a ar:DecisionStage ; ar:sequence 9 ; skos:prefLabel "Transit confirmation"@en ; ar:stageRequiresFactor wealth:TransitConfirmation .
wealth:RemedyStage a ar:DecisionStage ; ar:sequence 8 ; skos:prefLabel "Calculated remedy selection"@en ; ar:stageRequiresFactor wealth:RemedyBlueprint .

# Question types. Every static route excludes timing; every timed route requires the complete chain.
wealth:OverallWealth a ar:QuestionType ; ar:stableId "wealth.overall" ; ar:runtimeKey "wealth" ; skos:prefLabel "Overall wealth potential"@en ; ar:questionExample "What does my chart show about wealth?" ; ar:inDomain wealth:Wealth ; ar:requiresFactor wealth:D1, wealth:D2, wealth:H2, wealth:H5, wealth:H9, wealth:H10, wealth:H11, wealth:H6, wealth:H8, wealth:H12, wealth:LordNakshatraChain, wealth:DignityStrength, wealth:DhanaYogas, wealth:InduLagna, wealth:HoraLagna, wealth:ArudhaGains ; ar:defaultExcludesFactor wealth:DashaActivation, wealth:TransitConfirmation ; ar:requiresCapability wealth:CapNatalFoundation, wealth:CapD2, wealth:CapLordChain, wealth:CapStrength, wealth:CapYogas, wealth:CapIndu, wealth:CapSpecialLagnas ; ar:allowedAnswerMode wealth:ModeTopic ; ar:usesAnswerContract wealth:ContractStatic ; ar:hasEvidencePolicy wealth:EvidenceStatic ; ar:evaluatesRule wealth:RulePromiseFirst, wealth:RuleRetentionVsGain, wealth:RuleYogaOperational ; ar:evaluatesStage wealth:NatalStage, wealth:ManifestationStage, wealth:RiskStage ; ar:hasGuardrail wealth:NoUnrequestedTiming, wealth:D1D2Required, wealth:InduNoOverride, wealth:NoActivationPolarity, wealth:NoPropertyDrift, wealth:NoCareerDrift .
wealth:WealthSource a ar:QuestionType ; ar:stableId "wealth.source" ; ar:runtimeKey "wealth_source" ; skos:prefLabel "Primary wealth-building source"@en ; ar:questionExample "What is my strongest way to build wealth?" ; ar:inDomain wealth:Wealth ; ar:requiresFactor wealth:D1, wealth:D2, wealth:H2, wealth:H6, wealth:H7, wealth:H10, wealth:H11, wealth:D10, wealth:LordNakshatraChain, wealth:DignityStrength, wealth:InduLagna, wealth:HoraLagna, wealth:ArudhaGains ; ar:defaultExcludesFactor wealth:DashaActivation, wealth:TransitConfirmation ; ar:requiresCapability wealth:CapNatalFoundation, wealth:CapD2, wealth:CapLordChain, wealth:CapStrength, wealth:CapIndu, wealth:CapSpecialLagnas, wealth:CapDivisionals ; ar:allowedAnswerMode wealth:ModeCapacity ; ar:usesAnswerContract wealth:ContractStatic ; ar:hasEvidencePolicy wealth:EvidenceStatic ; ar:evaluatesRule wealth:RulePromiseFirst, wealth:RuleRouteSpecific ; ar:evaluatesStage wealth:NatalStage, wealth:ManifestationStage, wealth:SourceStage ; ar:hasGuardrail wealth:NoUnrequestedTiming, wealth:D1D2Required, wealth:InduNoOverride, wealth:NoCareerDrift .
wealth:WealthDiagnosis a ar:QuestionType ; ar:stableId "wealth.diagnosis" ; ar:runtimeKey "wealth_diagnosis" ; skos:prefLabel "Savings instability diagnosis"@en ; ar:questionExample "Why do my savings remain unstable?" ; ar:inDomain wealth:Wealth ; ar:requiresFactor wealth:D1, wealth:D2, wealth:H2, wealth:H6, wealth:H8, wealth:H11, wealth:H12, wealth:LordNakshatraChain, wealth:DignityStrength, wealth:InduLagna, wealth:HoraLagna, wealth:ArudhaGains ; ar:defaultExcludesFactor wealth:DashaActivation, wealth:TransitConfirmation ; ar:requiresCapability wealth:CapNatalFoundation, wealth:CapD2, wealth:CapLordChain, wealth:CapStrength, wealth:CapIndu, wealth:CapSpecialLagnas ; ar:allowedAnswerMode wealth:ModeDiagnosis ; ar:usesAnswerContract wealth:ContractStatic ; ar:hasEvidencePolicy wealth:EvidenceStatic ; ar:evaluatesRule wealth:RuleRetentionVsGain, wealth:RuleRouteSpecific ; ar:evaluatesStage wealth:NatalStage, wealth:ManifestationStage, wealth:RiskStage ; ar:hasGuardrail wealth:NoUnrequestedTiming, wealth:D1D2Required, wealth:NoActivationPolarity .
wealth:WealthTiming a ar:QuestionType ; ar:stableId "wealth.timing" ; ar:runtimeKey "wealth_timing" ; skos:prefLabel "Wealth growth timing"@en ; ar:questionExample "When is my next wealth growth period?" ; ar:inDomain wealth:Wealth ; ar:requiresFactor wealth:D1, wealth:D2, wealth:H2, wealth:H9, wealth:H11, wealth:H6, wealth:H8, wealth:H12, wealth:LordNakshatraChain, wealth:DignityStrength, wealth:DhanaYogas, wealth:InduLagna, wealth:HoraLagna, wealth:ArudhaGains, wealth:KPFructification, wealth:DashaActivation, wealth:TransitConfirmation ; ar:requiresCapability wealth:CapNatalFoundation, wealth:CapD2, wealth:CapLordChain, wealth:CapStrength, wealth:CapYogas, wealth:CapIndu, wealth:CapSpecialLagnas, wealth:CapKP, wealth:CapDasha, wealth:CapTransit ; ar:allowedAnswerMode wealth:ModeTiming ; ar:usesAnswerContract wealth:ContractTimed ; ar:hasEvidencePolicy wealth:EvidenceTimed ; ar:evaluatesRule wealth:RulePromiseFirst, wealth:RuleRetentionVsGain, wealth:RuleTimedChain ; ar:evaluatesStage wealth:NatalStage, wealth:ManifestationStage, wealth:RiskStage, wealth:DashaStage, wealth:TransitStage ; ar:hasGuardrail wealth:D1D2Required, wealth:InduNoOverride, wealth:NoActivationPolarity, wealth:NoNodeFifthNinth, wealth:NoGuaranteedReturn, wealth:StrictHorizon .

wealth:IncomeStability a ar:QuestionType ; ar:stableId "wealth.income" ; ar:runtimeKey "income" ; skos:prefLabel "Income and cash-flow stability"@en ; ar:questionExample "How stable is my income?" ; ar:inDomain wealth:Wealth ; ar:requiresFactor wealth:D1, wealth:D2, wealth:D10, wealth:H2, wealth:H6, wealth:H10, wealth:H11, wealth:LordNakshatraChain, wealth:DignityStrength, wealth:InduLagna, wealth:HoraLagna, wealth:ArudhaGains, wealth:KPFructification ; ar:defaultExcludesFactor wealth:DashaActivation, wealth:TransitConfirmation ; ar:requiresCapability wealth:CapNatalFoundation, wealth:CapD2, wealth:CapLordChain, wealth:CapStrength, wealth:CapIndu, wealth:CapSpecialLagnas, wealth:CapKP, wealth:CapDivisionals ; ar:allowedAnswerMode wealth:ModeTopic ; ar:usesAnswerContract wealth:ContractStatic ; ar:hasEvidencePolicy wealth:EvidenceStatic ; ar:evaluatesRule wealth:RulePromiseFirst, wealth:RuleRetentionVsGain, wealth:RuleRouteSpecific ; ar:evaluatesStage wealth:NatalStage, wealth:ManifestationStage, wealth:IncomeStage ; ar:hasGuardrail wealth:NoUnrequestedTiming, wealth:D1D2Required, wealth:NoCareerDrift .
