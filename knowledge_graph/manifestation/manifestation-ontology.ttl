ar:H9 a ar:House ; ar:stableId "house.9" ; skos:prefLabel "House 9"@en .
ar:H10 a ar:House ; ar:stableId "house.10" ; skos:prefLabel "House 10"@en .
ar:H11 a ar:House ; ar:stableId "house.11" ; skos:prefLabel "House 11"@en .
ar:H12 a ar:House ; ar:stableId "house.12" ; skos:prefLabel "House 12"@en .

# Contextual meanings. Houses are intentionally polysemous; each meaning is a
# separate graph node that can participate in a different life-domain lens.
manifestation:H1Identity a ar:HouseMeaning ; ar:stableId "house.1.identity" ; skos:prefLabel "identity and self-definition"@en ; ar:meaningOfHouse ar:H1 ; ar:inDomain domain:Self .
