ar:timelineVarga a owl:DatatypeProperty ; rdfs:label "Event Timeline divisional chart"@en .
ar:timelineAnchorHouse a owl:ObjectProperty ; rdfs:label "Event Timeline anchor house"@en .
ar:timelineTransitionHouse a owl:ObjectProperty ; rdfs:label "Event Timeline transition house"@en .
ar:timelineOutcomeHouse a owl:ObjectProperty ; rdfs:label "Event Timeline outcome house"@en .
ar:timelineVargaHouse a owl:ObjectProperty ; rdfs:label "Event Timeline divisional house"@en .
ar:timelineOutcomeRequired a owl:DatatypeProperty ; rdfs:label "Event Timeline requires outcome activation"@en .
ar:timelineOutcomeRequireAll a owl:DatatypeProperty ; rdfs:label "Event Timeline requires every outcome house"@en .
ar:timelineTransitionRequireAll a owl:DatatypeProperty ; rdfs:label "Event Timeline requires every transition house"@en .
ar:timelineRequiredContext a owl:DatatypeProperty ; rdfs:label "Event Timeline context eligibility expression"@en .

# Canonical house nodes. Meanings remain contextual and belong to patterns.
ar:H1 a ar:House ; ar:stableId "house.1" ; skos:prefLabel "House 1"@en .
ar:H2 a ar:House ; ar:stableId "house.2" ; skos:prefLabel "House 2"@en .
ar:H3 a ar:House ; ar:stableId "house.3" ; skos:prefLabel "House 3"@en .
ar:H4 a ar:House ; ar:stableId "house.4" ; skos:prefLabel "House 4"@en .
ar:H5 a ar:House ; ar:stableId "house.5" ; skos:prefLabel "House 5"@en .
ar:H6 a ar:House ; ar:stableId "house.6" ; skos:prefLabel "House 6"@en .
ar:H7 a ar:House ; ar:stableId "house.7" ; skos:prefLabel "House 7"@en .
