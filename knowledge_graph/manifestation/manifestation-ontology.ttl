ar:pathwayHouse a owl:ObjectProperty ; rdfs:label "Domain pathway house"@en .
ar:resultHouse a owl:ObjectProperty ; rdfs:label "Domain result house"@en .
ar:pressureHouse a owl:ObjectProperty ; rdfs:label "Domain pressure house"@en .
ar:stableId a owl:DatatypeProperty ; rdfs:label "Stable identifier"@en .
ar:labelKey a owl:DatatypeProperty ; rdfs:label "Localization label key"@en .
ar:promptKey a owl:DatatypeProperty ; rdfs:label "Localization prompt key"@en .
ar:claimBasis a owl:DatatypeProperty ; rdfs:label "Claim basis"@en .
ar:reviewStatus a owl:DatatypeProperty ; rdfs:label "Review status"@en .
ar:systemScope a owl:DatatypeProperty ; rdfs:label "Astrological system scope"@en .
ar:allowedPhase a owl:DatatypeProperty ; rdfs:label "Allowed manifestation phase"@en .
ar:minimumAny a owl:DatatypeProperty ; rdfs:label "Minimum any-house matches"@en .
ar:priority a owl:DatatypeProperty ; rdfs:label "Resolution priority"@en .
ar:sensitive a owl:DatatypeProperty ; rdfs:label "Sensitive manifestation"@en .
ar:sourcePath a owl:DatatypeProperty ; rdfs:label "Source path"@en .
ar:sourceNote a owl:DatatypeProperty ; rdfs:label "Source note"@en .
ar:meaningScope a owl:DatatypeProperty ; rdfs:label "House meaning scope"@en .
ar:derivationNote a owl:DatatypeProperty ; rdfs:label "House meaning derivation note"@en .
