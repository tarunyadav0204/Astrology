<https://astroroshni.com/ontology/manifestations>
    a owl:Ontology ;
    rdfs:label "AstroRoshni manifestation ontology"@en ;
    owl:versionInfo "0.3.2" .

ar:House a owl:Class ; rdfs:label "House"@en .
ar:Manifestation a owl:Class ; rdfs:label "Manifestation"@en .
